@*
    Shared modal for deleting a surcharge, triggered by each 'Xóa' button. Uses anti-forgery and POST method.
*@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa phụ thu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Bạn có chắc chắn muốn xóa phụ thu này?
      </div>
      <div class="modal-footer">
        <form method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Xóa</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        </form>
      </div>
    </div>
  </div>
</div>
