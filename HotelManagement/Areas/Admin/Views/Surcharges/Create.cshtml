@model HotelManagement.Models.ViewModels.SurchargeViewModel
@{
    ViewData["Title"] = "Thêm phụ thu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="InvoiceId" class="form-label"></label>
        <select asp-for="InvoiceId" class="form-select" asp-items="ViewBag.InvoiceList">
            <option value="">-- Chọn hóa đơn --</option>
        </select>
        <span asp-validation-for="InvoiceId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <input asp-for="Reason" class="form-control" />
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
