@model IEnumerable<HotelManagement.Models.ViewModels.RoomViewModel>

@{
    ViewData["Title"] = "Quản lý Phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 text-dark fw-bold">@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="fas fa-plus me-1"></i>Thêm phòng mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4 py-3">Ảnh</th>
                        <th class="py-3">Số phòng</th>
                        <th class="py-3">Loại phòng</th>
                        <th class="py-3">Giá</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3">Kích hoạt</th>
                        <th class="text-center pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4" style="width: 120px;">
                                @if (item.Images != null && item.Images.Count > 0)
                                {
                                    <div class="position-relative d-inline-block">
                                        <img src="@item.Images[0].Url" class="rounded-3 shadow-sm border border-1" alt="Room" style="height: 50px; width: 80px; object-fit: cover;" />
                                        @if (item.Images.Count > 1)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark border border-white">
                                                +@(item.Images.Count - 1)
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fas fa-image fa-2x opacity-25"></i></span>
                                }
                            </td>
                            <td class="fw-bold fs-5">@item.RoomNumber</td>
                            <td>@item.RoomTypeName</td>
                            <td class="text-primary fw-bold">@(item.Price?.ToString("N0") + " VND" ?? "N/A")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Available": <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Trống</span>; break;
                                    case "Booked": <span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm">Đã đặt</span>; break;
                                    case "Occupied": <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">Đang sử dụng</span>; break;
                                    case "Maintenance": <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">Bảo trì</span>; break;
                                    default: <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm">@item.Status</span>; break;
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-check me-1"></i>Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-ban me-1"></i>Vô hiệu</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-area="Admin" asp-controller="Rooms" asp-action="Edit" asp-route-id="@item.RoomId" class="btn btn-outline-warning btn-sm rounded-circle shadow-none p-1 border-0 me-1" title="Sửa">
                                    <i class="fas fa-edit fa-fw"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Rooms" asp-action="Feedbacks" asp-route-roomId="@item.RoomId" class="btn btn-outline-info btn-sm rounded-circle shadow-none p-1 border-0 me-1" title="Feedbacks">
                                    <i class="fas fa-comments fa-fw"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Rooms" asp-action="ToggleActive" asp-route-id="@item.RoomId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle shadow-none p-1 border-0" title="Vô hiệu hóa phòng">
                                            <i class="fas fa-ban fa-fw"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-success btn-sm rounded-circle shadow-none p-1 border-0" title="Kích hoạt phòng">
                                            <i class="fas fa-check fa-fw"></i>
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

