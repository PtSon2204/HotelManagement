@model HotelManagement.Models.ViewModels.RoomViewModel

@{
    ViewData["Title"] = "Sửa phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container" style="padding-top: 50px;">
    <h2>Sửa phòng</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-area="Admin" asp-controller="Rooms" asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="RoomId" />
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="RoomNumber" class="control-label">Số phòng</label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="RoomTypeName" class="control-label">Loại phòng</label>
                            <input asp-for="RoomTypeName" class="form-control" placeholder="Ví dụ: Standard, VIP, Suite..." />
                            <span asp-validation-for="RoomTypeName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label d-block">Hình ảnh hiện tại</label>
                    @if (Model.Images != null && Model.Images.Count > 0)
                    {
                        <div class="d-flex flex-wrap" style="gap: 12px;">
                            @for (var i = 0; i < Model.Images.Count; i++)
                            {
                                var img = Model.Images[i];
                                <div style="border: 1px solid #ddd; padding: 8px; border-radius: 6px;">
                                    <div style="width: 140px; height: 90px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#f8f9fa;">
                                        <img src="@img.Url" alt="Room image" style="max-width: 140px; max-height: 90px;" />
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="DeleteImageIds" value="@img.ImageId" id="del_@img.ImageId" />
                                        <label class="form-check-label" for="del_@img.ImageId">Xóa ảnh</label>
                                    </div>
                                </div>
                            }
                        </div>
                        <small class="form-text text-muted">Chọn ảnh cần xóa rồi bấm Lưu.</small>
                    }
                    else
                    {
                        <div class="text-muted">Chưa có ảnh</div>
                    }
                </div>

                <div class="form-group mb-3">
                    <label class="control-label d-block">Thêm ảnh mới (tối đa 2MB/ảnh)</label>
                    <input type="file" name="imageFiles" class="form-control" accept="image/*" multiple />
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Price" class="control-label">Giá (VND)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Status" class="control-label">Trạng thái</label>
                            <select asp-for="Status" class="form-control">
                                <option value="Available">Trống</option>
                                <option value="Booked">Đã đặt</option>
                                <option value="Occupied">Đang sử dụng</option>
                                <option value="Maintenance">Bảo trì</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                </div>


                <div class="form-group mb-3">
                    <input type="submit" value="Lưu" class="btn btn-primary" />
                    <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
