@model IEnumerable<HotelManagement.Models.ViewModels.FeedbackViewModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Phản hồi - Phòng " + (ViewBag.RoomNumber ?? "");
    var currentUrl = Url.Action("Feedbacks", "Rooms", new { roomId = ViewBag.RoomId });
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 text-dark fw-bold">Phản hồi của Phòng @ViewBag.RoomNumber</h2>
    <a asp-action="Index" asp-controller="Rooms" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm">
        <i class="fas fa-arrow-left me-1"></i>Trở lại danh sách phòng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-comment-slash fa-3x mb-3 text-light"></i>
                <h5>Không có phản hồi nào cho phòng này.</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Khách hàng</th>
                            <th class="py-3">Đánh giá</th>
                            <th class="py-3">Nội dung</th>
                            <th class="py-3">Ngày gửi</th>
                            <th class="text-center pe-4 py-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.FullName</td>
                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= item.Rating ? "text-warning" : "text-muted small shadow-none opacity-25")"></i>
                                    }
                                </td>
                                <td class="text-wrap" style="max-width: 300px;">
                                    <p class="mb-0 text-muted small">@item.Comment</p>
                                </td>
                                <td>@(item.FeedbackDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td class="text-center pe-4">
                                    <form asp-controller="Feedbacks" asp-action="Delete" method="post" onsubmit="return confirm('Xác nhận gỡ bỏ phản hồi này?')">
                                        <input type="hidden" name="id" value="@item.FeedbackId" />
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1">
                                            <i class="fas fa-trash-alt me-1"></i>Gỡ bỏ
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
