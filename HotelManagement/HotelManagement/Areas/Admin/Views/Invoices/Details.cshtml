@model HotelManagement.Models.ViewModels.InvoiceViewModel
@{
    ViewData["Title"] = "Hóa đơn #" + Model.InvoiceId;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var surcharges = ViewBag.Surcharges as List<HotelManagement.Models.Entities.Surcharge>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 text-dark fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i>Trở lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="row g-4">
        <!-- Thông tin Hóa đơn -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom-light">
                    <h5 class="card-title mb-0 fw-bold">Thông tin Hóa đơn & Khách hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Khách hàng</label>
                            <h5 class="fw-bold mb-1">@Model.CustomerName</h5>
                            <p class="text-muted mb-0">SĐT: @Model.CustomerPhone | Email: @Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Phòng & Đặt phòng</label>
                            <h5 class="fw-bold mb-1">Phòng @Model.RoomNumber</h5>
                            <p class="text-muted mb-0">Booking ID: #@Model.BookingId | Loại: @Model.RoomTypeName</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Check-in / Check-out</label>
                            <p class="mb-0">@Model.CheckIn.ToString("dd/MM/yyyy") - @Model.CheckOut.ToString("dd/MM/yyyy")</p>
                            <p class="text-muted small">(@Model.NumberOfDays đêm)</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Trạng thái</label>
                            <span class="badge @(Model.Status == "Paid" ? "bg-success" : "bg-warning text-dark") px-3 py-2 rounded-pill">
                                @(Model.Status == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                            </span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Ngày thanh toán</label>
                            <p class="mb-0 fw-bold">@(Model.PaymentDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</p>
                        </div>
                    </div>

                    <hr class="my-4 border-light">

                    <h5 class="fw-bold mb-3">Chi tiết tiền phòng & dịch vụ</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless align-middle mb-0">
                            <tbody>
                                <tr>
                                    <td>Phòng (@Model.RoomNumber x @Model.NumberOfDays đêm)</td>
                                    <td class="text-end fw-bold">@Model.RoomTotal.ToString("N0") VND</td>
                                </tr>
                                @foreach (var svc in Model.Services)
                                {
                                    <tr>
                                        <td>@svc.ServiceName</td>
                                        <td class="text-end fw-bold">@(svc.Price?.ToString("N0") + " VND" ?? "N/A")</td>
                                    </tr>
                                }
                                <tr class="border-top-light border-2">
                                    <td class="pt-3">Đặt cọc (Khấu trừ)</td>
                                    <td class="pt-3 text-end text-danger fw-bold">- @(Model.Deposit?.ToString("N0") + " VND" ?? "0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Danh sách Phụ thu (Surcharges) -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 border-bottom-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">Phụ thu (Surcharges)</h5>
                    <span class="badge bg-primary rounded-pill">@(surcharges?.Count ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="bg-light text-secondary">
                                <tr>
                                    <th class="ps-4">Lý do</th>
                                    <th>Ngày tạo</th>
                                    <th class="text-end">Số tiền</th>
                                    <th class="text-center pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (surcharges != null && surcharges.Any())
                                {
                                    @foreach (var s in surcharges)
                                    {
                                        <tr>
                                            <td class="ps-4">@s.Reason</td>
                                            <td>@s.CreatedDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end fw-bold text-primary">@s.Amount.ToString("N0") VND</td>
                                            <td class="text-center pe-4">
                                                @if (Model.Status != "Paid")
                                                {
                                                    <form asp-action="DeleteSurcharge" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa phụ thu này?')">
                                                        <input type="hidden" name="id" value="@s.SurchargeId" />
                                                        <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle shadow-none p-1 border-0">
                                                            <i class="fas fa-trash-alt fa-fw"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-lock text-muted" title="Hóa đơn đã khóa"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-info-circle me-1"></i>Chưa có phụ thu nào được đính kèm.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Tổng cộng -->
            <div class="card shadow-sm border-0 rounded-4 mb-4 border-top border-4 border-primary">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Tổng cộng hóa đơn</h5>
                    <div class="display-6 fw-bold text-primary text-center my-4">@Model.TotalAmount.ToString("N0") VND</div>
                    <div class="alert alert-light border-0 small text-muted">
                        <i class="fas fa-info-circle me-2"></i>Tổng tiền bao gồm tiền phòng, dịch vụ và phụ thu đã được khấu trừ tiền cọc.
                    </div>
                    
                    @if (Model.Status == "Unpaid")
                    {
                        <form asp-action="MarkAsPaid" method="post" class="mt-3">
                            <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" onclick="return confirm('Bạn có chắc chắn hóa đơn này đã được thanh toán đầy đủ? Hành động này sẽ khóa hóa đơn và không thể hoàn tác.')">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Thêm Phụ thu -->
            @if (Model.Status != "Paid")
            {
                <div class="card shadow-sm border-0 rounded-4 border-top border-4 border-success">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">Thêm phụ thu mới</h5>
                        <form asp-action="AddSurcharge" method="post">
                            <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Lý do</label>
                                <input type="text" name="reason" class="form-control shadow-none rounded-3" placeholder="Ví dụ: Làm hỏng vật tư, Check-out trễ..." required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-muted small fw-bold">Số tiền</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white rounded-start-3 border-end-0">₫</span>
                                    <input type="number" name="amount" class="form-control shadow-none rounded-end-3" placeholder="0" min="0" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-plus me-2"></i>Thêm phụ thu
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-4 border-top border-4 border-secondary bg-light">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                        <h5 class="fw-bold text-muted">Hóa đơn đã đóng</h5>
                        <p class="text-muted small mb-0">Không thể thêm phụ thu vào hóa đơn đã thanh toán.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
