@model HotelManagement.Models.ViewModels.InvoiceViewModel
@{
    ViewData["Title"] = "Hóa đơn #" + Model.InvoiceId;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0 text-dark fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i>Trở lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
    }

    <div class="row g-4">
        <!-- Thông tin Hóa đơn -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom-light">
                    <h5 class="card-title mb-0 fw-bold">Thông tin Hóa đơn & Khách hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Khách hàng</label>
                            <h5 class="fw-bold mb-1">@Model.CustomerName</h5>
                            <p class="text-muted mb-0">SĐT: @Model.CustomerPhone | Email: @Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Phòng & Đặt phòng</label>
                            <h5 class="fw-bold mb-1">Phòng @Model.RoomNumber</h5>
                            <p class="text-muted mb-0">Booking ID: #@Model.BookingId | Loại: @Model.RoomTypeName</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Check-in / Check-out</label>
                            <p class="mb-0">@Model.CheckIn.ToString("dd/MM/yyyy") - @Model.CheckOut.ToString("dd/MM/yyyy")</p>
                            <p class="text-muted small">(@Model.NumberOfDays đêm)</p>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Trạng thái</label>
                            <span class="badge @(Model.Status == "Paid" ? "bg-success" : "bg-warning") px-3 py-2 rounded-pill">
                                @(Model.Status == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                            </span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Ngày thanh toán</label>
                            <p class="mb-0 fw-bold">@(Model.PaymentDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</p>
                        </div>
                    </div>

                    <hr class="my-4 border-light">

                    <h5 class="fw-bold mb-3">Chi tiết tiền phòng & dịch vụ</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless align-middle mb-0">
                            <tbody>
                                <tr>
                                    <td>Phòng (@Model.RoomNumber x @Model.NumberOfDays đêm)</td>
                                    <td class="text-end fw-bold">@Model.RoomTotal.ToString("N0") VND</td>
                                </tr>
                                @foreach (var svc in Model.Services)
                                {
                                    <tr>
                                        <td>@svc.ServiceName</td>
                                        <td class="text-end fw-bold">@(svc.Price?.ToString("N0") + " VND" ?? "N/A")</td>
                                    </tr>
                                }
                                <tr class="border-top border-2">
                                    <td class="pt-3">Đặt cọc (Khấu trừ)</td>
                                    <td class="pt-3 text-end text-danger fw-bold">- @(Model.Deposit?.ToString("N0") + " VND" ?? "0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Tổng cộng -->
            <div class="card shadow-sm border-0 rounded-4 border-top border-4 border-primary">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Tổng cộng hóa đơn</h5>
                    <div class="display-6 fw-bold text-primary text-center my-4">@Model.TotalAmount.ToString("N0") VND</div>
                    <div class="alert alert-light border-0 small text-muted">
                        <i class="fas fa-info-circle me-2"></i>Tổng tiền bao gồm tiền phòng và dịch vụ, đã khấu trừ tiền cọc.
                    </div>

                    @if (Model.Status == "Unpaid")
                    {
                        <form asp-action="MarkAsPaid" method="post" class="mt-3">
                            <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm"
                                    onclick="return confirm('Xác nhận hóa đơn đã thanh toán đầy đủ?')">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-success border-0 text-center mt-3 rounded-3">
                            <i class="fas fa-lock me-2"></i>Hóa đơn đã thanh toán & đóng
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
