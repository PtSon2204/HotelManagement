@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var username = Context.Session.GetString("Username") ?? "Admin";
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] - Quản trị</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #f4f6f9;
        }

        /* ── Sidebar ── */
        .admin-sidebar {
            position: fixed;
            top: 0; left: 0;
            width: 240px;
            height: 100vh;
            background: #2c3e50;
            color: #ecf0f1;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .admin-sidebar .sidebar-brand {
            padding: 24px 20px 16px;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            text-decoration: none;
        }

        .admin-sidebar nav {
            flex: 1;
            padding: 16px 0;
            overflow-y: auto;
        }

        .admin-sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 24px;
            color: #bdc3c7;
            text-decoration: none;
            font-size: 0.92rem;
            transition: background 0.15s, color 0.15s;
        }

        .admin-sidebar nav a:hover {
            background: rgba(255,255,255,0.07);
            color: #fff;
        }

        .admin-sidebar nav a.active {
            background: #d4a037;
            color: #fff;
        }

        .admin-sidebar nav a i {
            width: 18px;
            text-align: center;
        }

        .sidebar-divider {
            border-top: 1px solid rgba(255,255,255,0.1);
            margin: 8px 0;
        }

        /* ── Topbar ── */
        .admin-topbar {
            position: fixed;
            top: 0;
            left: 240px;
            right: 0;
            height: 56px;
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 24px;
            gap: 16px;
            z-index: 999;
        }

        .admin-topbar .topbar-username {
            font-weight: 600;
            color: #2c3e50;
            font-size: 0.9rem;
        }

        .admin-topbar a {
            font-size: 0.85rem;
            padding: 6px 14px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 500;
        }

        .btn-site {
            background: #ecf0f1;
            color: #2c3e50;
            border: 1px solid #ccc;
        }

        .btn-site:hover {
            background: #dfe6e9;
            color: #2c3e50;
        }

        .btn-logout {
            background: #e74c3c;
            color: #fff;
        }

        .btn-logout:hover {
            background: #c0392b;
            color: #fff;
        }

        /* ── Override Bootstrap btn-primary to hotel gold ── */
        .btn-primary {
            background-color: #d4a037;
            border-color: #d4a037;
            color: #fff;
        }
        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary:not(:disabled):not(.disabled):active {
            background-color: #b8882e;
            border-color: #b8882e;
            color: #fff;
        }

        /* Enforce white text on all badges/pills */
        .badge {
            color: #ffffff !important;
        }

        /* ── Content ── */
        .admin-content {
            margin-left: 240px;
            padding-top: 56px;
            min-height: 100vh;
        }

        .admin-content > div {
            padding: 24px 32px;
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <a class="sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="fas fa-hotel"></i>&nbsp; Quản trị
        </a>
        <nav>
            <div class="sidebar-divider"></div>
            <div class="sidebar-category mt-2 mb-2 px-3 text-uppercase fw-bold text-muted small" style="letter-spacing: 1px; font-size: 0.75rem;"><i class="fas fa-chart-pie me-1"></i> Tổng quan & Báo cáo</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="@(currentController == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a asp-area="Admin" asp-controller="Analytics" asp-action="Index"
               class="@(currentController == "Analytics" ? "active" : "")">
                <i class="fas fa-chart-bar"></i> Hiệu suất
            </a>
            <a asp-area="Admin" asp-controller="VipGuests" asp-action="Index"
               class="@(currentController == "VipGuests" ? "active" : "")">
                <i class="fas fa-trophy"></i> Khách VIP
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-category mt-2 mb-2 px-3 text-uppercase fw-bold text-muted small" style="letter-spacing: 1px; font-size: 0.75rem;"><i class="fas fa-building me-1"></i> Quản lý Dịch vụ</div>
            <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
               class="@(currentController == "Bookings" ? "active" : "")">
                <i class="fas fa-calendar-alt"></i> Đặt phòng
            </a>
            <a asp-area="Admin" asp-controller="Rooms" asp-action="Index"
               class="@(currentController == "Rooms" ? "active" : "")">
                <i class="fas fa-bed"></i> Phòng
            </a>
            <a asp-area="Admin" asp-controller="Services" asp-action="Index"
               class="@(currentController == "Services" ? "active" : "")">
                <i class="fas fa-utensils"></i> Dịch vụ
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-category mt-2 mb-2 px-3 text-uppercase fw-bold text-muted small" style="letter-spacing: 1px; font-size: 0.75rem;"><i class="fas fa-money-bill-alt me-1"></i> Tài chính</div>
            <a asp-area="Admin" asp-controller="Invoices" asp-action="Index"
               class="@(currentController == "Invoices" ? "active" : "")">
                <i class="fas fa-file-alt"></i> Hóa đơn
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-category mt-2 mb-2 px-3 text-uppercase fw-bold text-muted small" style="letter-spacing: 1px; font-size: 0.75rem;"><i class="fas fa-users me-1"></i> Nhân sự & Khách hàng</div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="@(currentController == "Users" ? "active" : "")">
                <i class="fas fa-user-circle"></i> Tài khoản
            </a>
            <a asp-area="Admin" asp-controller="GuestProfiles" asp-action="Index"
               class="@(currentController == "GuestProfiles" ? "active" : "")">
                <i class="fas fa-id-badge"></i> Hồ sơ Khách
            </a>
            <a asp-area="Admin" asp-controller="Roles" asp-action="Index"
               class="@(currentController == "Roles" ? "active" : "")">
                <i class="fas fa-shield-alt"></i> Quyền hạn
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-category mt-2 mb-2 px-3 text-uppercase fw-bold text-muted small" style="letter-spacing: 1px; font-size: 0.75rem;"><i class="fas fa-comments me-1"></i> Tương tác</div>
            <a asp-area="Admin" asp-controller="Feedbacks" asp-action="Index"
               class="@(currentController == "Feedbacks" ? "active" : "")">
                <i class="fas fa-comment-alt"></i> Phản hồi
            </a>
            <a asp-area="Admin" asp-controller="Chat" asp-action="Index"
               class="@(currentController == "Chat" ? "active" : "")">
                <i class="fas fa-headphones"></i> Tin nhắn Staff
            </a>

            <div class="sidebar-divider"></div>
            <a href="/Home/Index">
                <i class="fas fa-arrow-left"></i> Về trang chủ
            </a>
        </nav>
    </aside>

    <!-- Topbar -->
    <header class="admin-topbar">
        <span class="topbar-username"><i class="fas fa-user-circle"></i> @username</span>
        <a href="/Home/Index" class="btn-site">Trang chủ</a>
        <a href="/Account/Logout" class="btn-logout">Đăng xuất</a>
    </header>

    <!-- Main content -->
    <div class="admin-content">
        <div>
            @RenderBody()
        </div>
    </div>

    <script src="~/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    @if (IsSectionDefined("Scripts"))
    {
        @await RenderSectionAsync("Scripts", required: false)
    }
</body>
</html>
