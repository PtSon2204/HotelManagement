@{
    ViewData["Title"] = "Trung tâm tin nhắn";
    var senderName = Context.Session.GetString("Username") ?? "Admin";
}

<div class="row justify-content-center">
    <div class="col-md-11">
        <div class="card border-0 shadow-sm" style="height: 75vh; display: flex; flex-direction: column;">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0">
                    <i class="bi bi-chat-left-text-fill me-2 text-primary"></i>Hệ thống Chat Nội bộ
                </h5>
            </div>

            <div id="chat-box" class="card-body p-4" style="flex-grow: 1; overflow-y: auto; background: #f8f9fa;">
                <div id="messagesList">
                    <div class="text-center text-muted my-3"><small>Đang kết nối hệ thống chat...</small></div>
                </div>
            </div>

            <div class="card-footer bg-white p-3 border-top">
                <div class="chat-input-group">
                    <input id="chatMessageInput" type="text" class="form-control chat-input" placeholder="Nhập nội dung tin nhắn..." maxlength="1000" />
                    <button id="sendMessageBtn" class="btn chat-send-btn" type="button">
                        Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .msg-item {
        margin-bottom: 12px;
        max-width: 72%;
        padding: 10px 15px;
        border-radius: 15px;
        position: relative;
        clear: both;
        overflow: hidden;
    }

    .msg-me {
        background: #d4af37;
        color: #fff;
        margin-left: auto;
        border-bottom-right-radius: 2px;
    }

    .msg-other {
        background: #e9ecef;
        color: #2b3674;
        border-bottom-left-radius: 2px;
    }

    .msg-time {
        font-size: 10px;
        display: block;
        margin-top: 5px;
        opacity: 0.8;
    }

    .chat-input-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-input {
        height: 46px;
        border: 0 !important;
        background: #f5f6f8 !important;
        border-radius: 10px !important;
        padding: 0 16px !important;
        box-shadow: none !important;
    }

    .chat-send-btn {
        min-width: 92px;
        height: 46px;
        border: 0;
        border-radius: 10px;
        background: #d4af37;
        color: #fff;
        font-weight: 600;
        padding: 0 18px;
    }

    .chat-send-btn:hover {
        background: #b8922f;
        color: #fff;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@6.0.1/dist/browser/signalr.min.js"></script>
<script>
    (function () {
        var msgList = document.getElementById("messagesList");
        var chatBox = document.getElementById("chat-box");
        var sendBtn = document.getElementById("sendMessageBtn");
        var messageInput = document.getElementById("chatMessageInput");
        var currentUser = "@senderName";
        if (!msgList) return;

        function showInfo(text) {
            msgList.innerHTML = '<div class="text-center text-muted my-3"><small>' + text + '</small></div>';
        }

        function showError(text) {
            msgList.innerHTML = '<div class="alert alert-danger mb-0">' + text + '</div>';
        }

        showInfo("Đang khởi tạo chat...");

        if (!window.signalR) {
            showError("Không tải được thư viện SignalR. Hãy kiểm tra mạng hoặc firewall.");
            return;
        }

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        function escapeHtml(text) {
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function appendMessage(user, message, time) {
            var safeUser = escapeHtml(user);
            var safeMessage = escapeHtml(message);
            var safeTime = escapeHtml(time);
            var isMe = safeUser === currentUser;
            var msgHtml = `
                <div class="msg-item ${isMe ? 'msg-me' : 'msg-other'}">
                    <strong>${isMe ? 'Bạn' : safeUser}</strong>: ${safeMessage}
                    <small class="msg-time">${safeTime}</small>
                </div>`;
            msgList.insertAdjacentHTML("beforeend", msgHtml);
            if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
        }

        connection.on("ReceiveMessage", function (user, message, time) {
            if (!msgList.dataset.connected) {
                msgList.dataset.connected = "1";
                msgList.innerHTML = "";
            }
            appendMessage(user, message, time);
        });

        connection.onreconnecting(function () {
            showInfo("Mất kết nối, đang thử kết nối lại...");
        });

        connection.onreconnected(function () {
            showInfo("Đã kết nối lại hệ thống chat.");
            msgList.dataset.connected = "1";
        });

        connection.start()
            .then(function () {
                msgList.dataset.connected = "1";
                msgList.innerHTML = '<div class="text-center text-success small mb-3"><i class="fas fa-check-circle"></i> Hệ thống trực tuyến. Sẵn sàng nhận tin từ nhân viên.</div><hr>';
                return connection.invoke("GetRecentMessages", 200);
            })
            .then(function (history) {
                if (!Array.isArray(history) || history.length === 0) return;
                history.forEach(function (m) {
                    appendMessage(m.user, m.message, m.time);
                });
            })
            .then(function () {
                function sendCurrentMessage() {
                    var content = (messageInput.value || "").trim();
                    if (!content) return;

                    sendBtn.disabled = true;
                    connection.invoke("SendMessage", currentUser, content)
                        .then(function () {
                            messageInput.value = "";
                            messageInput.focus();
                        })
                        .catch(function (err) {
                            console.error("SendMessage error:", err);
                            showError("Gửi tin nhắn thất bại: " + (err && err.message ? err.message : "Unknown error"));
                        })
                        .finally(function () {
                            sendBtn.disabled = false;
                        });
                }

                sendBtn.addEventListener("click", sendCurrentMessage);
                messageInput.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        sendCurrentMessage();
                    }
                });
            })
            .catch(function (err) {
                console.error("SignalR start error:", err);
                showError("Không thể kết nối máy chủ chat: " + (err && err.message ? err.message : "Unknown error"));
            });
    })();
</script>