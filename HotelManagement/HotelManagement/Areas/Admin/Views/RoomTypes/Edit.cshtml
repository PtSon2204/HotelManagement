@model HotelManagement.Models.ViewModels.RoomTypeViewModel

@{
    ViewData["Title"] = "Sửa loại phòng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container" style="padding-top: 50px;">
    <h2>Sửa loại phòng</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-area="Admin" asp-controller="RoomTypes" asp-action="Edit" id="editForm" data-roomtype-form="true">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="RoomTypeId" />
                <input asp-for="Image" type="hidden" id="imagePathInput" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label d-block">Tên loại phòng</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Price" class="control-label d-block">Giá (VND)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Capacity" class="control-label d-block">Sức chứa (người)</label>
                            <input asp-for="Capacity" class="form-control" type="number" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="IsActive" class="control-label d-block">Trạng thái</label>
                            <select asp-for="IsActive" class="form-control">
                                <option value="true">Hoạt động</option>
                                <option value="false">Không hoạt động</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label d-block">Hình ảnh</label>
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="mb-2" id="imagePreviewWrap">
                            <img id="imagePreview" src="@Model.Image" alt="Ảnh hiện tại" style="max-height: 150px; border: 1px solid #ddd; padding: 3px;" />
                        </div>
                        <small class="text-muted">Chọn ảnh mới để thay thế, hoặc để trống để giữ ảnh hiện tại.</small>
                    }
                    else
                    {
                        <div class="mb-2" id="imagePreviewWrap" style="display:none;">
                            <img id="imagePreview" src="" alt="Xem trước" style="max-height: 150px; border: 1px solid #ddd; padding: 3px;" />
                        </div>
                    }
                    <input type="file" id="imageFileInput" class="form-control mt-1" accept="image/*" />
                    <small id="imageUploadStatus" class="form-text text-muted"></small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label d-block">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3 mt-4">
                    <input type="submit" id="submitBtn" value="Lưu" class="btn btn-primary" />
                    <a asp-area="Admin" asp-controller="RoomTypes" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        window.roomTypeUploadConfig = {
            uploadUrl: '@Url.Action("UploadImageBase64", "RoomTypes", new { area = "Admin" })',
            maxSizeBytes: 2097152
        };
    </script>
    <script src="~/assets/js/roomtypes-form.js"></script>
}
