@model HotelManagement.Models.Common.PagedResult<HotelManagement.Models.ViewModels.FeedbackViewModel>
@{
    ViewData["Title"] = "Quản lý Phản hồi (Feedback)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 text-dark fw-bold">@ViewData["Title"]</h2>
</div>

<div class="card mb-4 shadow-sm border-0 rounded-4">
    <div class="card-body py-4">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="search" class="form-control shadow-none rounded-start-pill border-1" placeholder="Tìm kiếm theo khách hàng, phòng, nội dung..." value="@search" />
                    <button class="btn btn-primary rounded-end-pill px-4" type="submit">
                        <i class="fas fa-search me-1"></i>Tìm kiếm
                    </button>
                </div>
            </div>
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4 py-3">Phòng</th>
                        <th class="py-3">Khách hàng</th>
                        <th class="py-3">Đánh giá</th>
                        <th class="py-3">Nội dung</th>
                        <th class="py-3">Ngày gửi</th>
                        <th class="text-center pe-4 py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">Phòng @item.RoomNumber</td>
                            <td>@item.FullName</td>
                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= item.Rating ? "text-warning" : "text-muted small shadow-none opacity-25")"></i>
                                }
                            </td>
                            <td class="text-wrap" style="max-width: 300px;">
                                <p class="mb-0 text-muted small">@item.Comment</p>
                            </td>
                            <td>@(item.FeedbackDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                            <td class="text-center pe-4">
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle shadow-none p-1 border-0"
                                        data-toggle="modal"
                                        data-target="#deleteModal"
                                        data-id="@item.FeedbackId"
                                        data-name="@item.FullName"
                                        title="Xóa phản hồi">
                                    <i class="fas fa-trash-alt fa-fw"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 py-4">
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link shadow-none border-1" href="?search=@search&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Xác nhận xóa</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body py-4 text-center">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <p class="text-muted mb-0">Bạn có chắc chắn muốn xóa phản hồi của</p>
                <strong id="deleteName" class="fs-5"></strong>?
            </div>
            <div class="modal-footer border-top-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteFeedbackId" />
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold">Xóa phản hồi</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');
                $('#deleteName').text(name);
                $('#deleteFeedbackId').val(id);
            });
        });
    </script>
}
