@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .card-dashboard {
        border: none;
        border-radius: 12px;
        color: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        /* Hiệu ứng khi di chuột vào */
        .card-dashboard:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
        }

        /* Định dạng chữ bên trong */
        .card-dashboard h6 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-dashboard h2 {
            font-size: 2.2rem;
            font-weight: bold;
            margin: 0;
        }

    /* 4 tông màu Gradient cho 4 ô */
    .bg-blue {
        background: linear-gradient(45deg, #4099ff, #73b4ff);
    }

    .bg-green {
        background: linear-gradient(45deg, #2ed8b6, #59e0c5);
    }

    .bg-orange {
        background: linear-gradient(45deg, #FFB64D, #ffcb80);
    }

    .bg-red {
        background: linear-gradient(45deg, #FF5370, #ff869a);
    }
</style>

<h3>Dashboard</h3>
<p class="text-muted">Quản lý khách sạn</p>

<div class="row mb-4 text-white">

    <div class="col-md-3 mb-3">
        <div class="card card-dashboard bg-blue p-4">
            <h6>Tổng số người dùng</h6>
            <h2>@ViewBag.NumberOfCustomers</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card card-dashboard bg-green p-4">
            <h6>Tổng số đặt phòng</h6>
            <h2>@ViewBag.NumberOfBookings</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card card-dashboard bg-orange p-4">
            <h6>Phòng còn trống</h6>
            <h2>@ViewBag.NumberOfRooms</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card card-dashboard bg-red p-4">
            <h6>Tổng số dịch vụ</h6>
            <h2>@ViewBag.NumberOfServices</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card card-dashboard bg-red p-4">
            <h6>Tổng số ý kiến</h6>
            <h2>0</h2>
        </div>
    </div>

</div>