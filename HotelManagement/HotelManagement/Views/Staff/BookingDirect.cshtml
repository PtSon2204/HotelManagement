@model HotelManagement.Models.ViewModels.DirectBookingViewModel

@{
    ViewData["Title"] = "Đặt phòng trực tiếp";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary">Nhận phòng trực tiếp</h2>
    </div>

    <form asp-action="BookingDirect" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <input type="hidden" asp-for="RoomId" />

        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card shadow border-0 h-100">
                    <div class="card-header bg-white pt-4 pb-2 border-bottom-0">
                        <h5 class="mb-0 text-primary fw-bold border-start border-4 border-primary ps-3">Thông tin khách hàng</h5>
                    </div>
                    <div class="card-body">

                        <div class="mb-3">
                            <label class="form-label fw-medium">Họ tên khách hàng <span class="text-danger">*</span></label>
                            <input required asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium d-block">Giới tính</label>
                                <div class="form-check form-check-inline mt-2">
                                    <input asp-for="Gender" type="radio" value="Male" class="form-check-input" id="genderMale" checked />
                                    <label class="form-check-label" for="genderMale">Nam</label>
                                </div>
                                <div class="form-check form-check-inline mt-2">
                                    <input asp-for="Gender" type="radio" value="Female" class="form-check-input" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Nữ</label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Quốc tịch <span class="text-danger">*</span></label>
                                <input required asp-for="Nationality" class="form-control" placeholder="VD: Việt Nam" />
                                <span asp-validation-for="Nationality" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Số CMND / Passport <span class="text-danger">*</span></label>
                                <input required asp-for="IdCard" class="form-control" />
                                <span asp-validation-for="IdCard" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Số điện thoại <span class="text-danger">*</span></label>
                                <input required asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Email</label>
                            <input asp-for="Email" placeholder="example@gmail.com" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Địa chỉ</label>
                            <textarea asp-for="Address" placeholder="Địa chỉ để xuất hóa đơn / hồ sơ" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow border-0 h-100">
                    <div class="card-header bg-white pt-4 pb-2 border-bottom-0">
                        <h5 class="mb-0 text-primary fw-bold border-start border-4 border-primary ps-3">Thông tin đặt phòng</h5>
                    </div>
                    <div class="card-body">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-muted">Mã phòng</label>
                                <input value="@Model.RoomId" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-muted">Số phòng</label>
                                <input value="@Model.RoomNumber" class="form-control bg-light fw-bold text-primary" readonly />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-muted">Loại phòng</label>
                                <input value="@Model.RoomTypeName" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium text-muted">Giá phòng</label>
                                <input value="@Model.Price" class="form-control bg-light text-danger fw-bold" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Số người lưu trú <span class="text-danger">*</span></label>
                            <input asp-for="NumberOfPeople" type="number" min="1" class="form-control" />
                            <span asp-validation-for="NumberOfPeople" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Ngày check-in <span class="text-danger">*</span></label>
                                <input asp-for="CheckInDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Ngày check-out dự kiến <span class="text-danger">*</span></label>
                                <input asp-for="CheckOutDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
            <a asp-action="RoomList" class="btn btn-light px-4 shadow-sm">
                Quay lại
            </a>
            <button type="reset" class="btn btn-outline-secondary px-4 shadow-sm">
                Làm lại
            </button>
            <button type="submit" class="btn btn-success px-4 shadow-sm">
                <i class="fas fa-check me-2"></i> Xác nhận đặt phòng
            </button>
        </div>
    </form>
</div>