@using HotelManagement.Models.Entities
@model HotelManagement.Models.ViewModels.BookingViewModel
@{
    ViewData["Title"] = "Thanh toán & Trả phòng";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";

    // Đảm bảo số tiền không bị âm
    decimal totalToPay = ViewBag.TotalToPay ?? 0;
}

<style>
    .border-dashed {
        border: 2px dashed #0d6efd;
    }

    .bg-success-light {
        background-color: #d1e7dd;
        border: 1px solid #badbcc;
    }

    .spinner-border {
        width: 1.5rem;
        height: 1.5rem;
        border-width: 0.2em;
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h5 class="border-bottom pb-2 mb-3 text-primary">Thông tin hóa đơn #@Model.BookingId</h5>

                    <div class="row mb-3">
                        <div class="col-6">
                            <p class="mb-1"><strong>Khách hàng:</strong> @Model.Customer?.FullName</p>
                            <p class="mb-1"><strong>Phòng:</strong> @Model.Room?.RoomNumber</p>
                            <p class="mb-0"><strong>Ngày nhận:</strong> @Model.CheckIn.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-6 text-end">
                            <div class="d-flex justify-content-between">
                                <span>Tổng tiền phòng:</span>
                                <strong>@Model.Room?.Price?.ToString("N0") VNĐ</strong>
                            </div>

                            <div class="d-flex justify-content-between mt-1">
                                <span>Tiền dịch vụ:</span>
                                <strong>@ViewBag.ServiceTotal?.ToString("N0") VNĐ</strong>
                            </div>

                            <div class="d-flex justify-content-between text-success mt-1">
                                <span>Khách đã trả (Cọc):</span>
                                <strong>- @Model.Deposit?.ToString("N0") VNĐ</strong>
                            </div>
                            <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                                <h5 class="mb-0 text-danger">Tiền còn thiếu:</h5>
                                <h5 class="text-danger mb-0 fw-bold">@totalToPay.ToString("N0") VNĐ</h5>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <form id="formCheckout" asp-controller="Staff" asp-action="ConfirmCheckOut" method="post">
                        <input type="hidden" name="id" value="@Model.BookingId" />

                        <div class="mb-4 d-flex justify-content-end gap-3" id="payment-method-selector">
                            <input type="radio" class="btn-check" name="paymentMethod" id="tienMat" value="Tiền mặt" autocomplete="off" checked>
                            <label class="btn btn-outline-secondary" for="tienMat">Thanh toán Tiền mặt</label>

                            <input type="radio" class="btn-check" name="paymentMethod" id="chuyenKhoan" value="Chuyển khoản" autocomplete="off">
                            <label class="btn btn-outline-primary" for="chuyenKhoan">Thanh Toán Chuyển Khoản (QR)</label>
                        </div>

                        <div id="cash-section" class="text-end">
                            <button type="button" id="btnCashSubmit" class="btn btn-danger btn-lg px-5">
                                Xác nhận Trả phòng & In Bill
                            </button>
                            <a asp-action="BookingDetail" asp-route-id="@Model.BookingId" class="btn btn-light ms-2">Quay lại</a>
                        </div>

                        <div id="qr-section" class="border-dashed rounded p-4 text-center mt-3" style="display: none;">
                            <h5 class="text-primary fw-bold mb-3">QUÉT MÁY VIETQR ĐỂ THANH TOÁN</h5>
                            <p class="text-muted small mb-3">Sử dụng App ngân hàng để quét mã</p>

                            <img id="qr-image" src="" alt="Mã QR Thanh Toán" class="img-fluid mb-4" style="max-height: 300px; width: auto;" />

                            <div class="d-flex flex-column align-items-center justify-content-center text-primary">
                                <div class="spinner-border mb-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span>Đang chờ xác nhận thanh toán...</span>
                            </div>

                            <div class="mt-4 pt-3 border-top">
                                <button type="button" id="btnSimulatePaid" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-check"></i> (Test) Đã nhận được chuyển khoản
                                </button>
                            </div>
                        </div>

                        <div id="success-section" class="bg-success-light rounded p-5 text-center mt-3" style="display: none;">
                            <div class="mb-3">
                                <img src="https://cdn-icons-png.flaticon.com/512/1904/1904425.png" alt="Success" style="width: 60px;" />
                            </div>
                            <h3 class="text-success mb-3">Thanh toán thành công!</h3>
                            <p class="mb-4">Thanh toán chuyển khoản thành công cho mã đặt phòng <strong>#@Model.BookingId</strong> với số tiền <strong>@totalToPay.ToString("N0") VNĐ</strong></p>

                            <button type="button" id="btnReturn" class="btn btn-success px-4 py-2">
                                Quay về danh sách
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy các elements
            const rdoCash = document.getElementById("tienMat");
            const rdoTransfer = document.getElementById("chuyenKhoan");
            const cashSection = document.getElementById("cash-section");
            const qrSection = document.getElementById("qr-section");
            const successSection = document.getElementById("success-section");
            const formCheckout = document.getElementById("formCheckout");

            const btnCashSubmit = document.getElementById("btnCashSubmit");
            const btnSimulatePaid = document.getElementById("btnSimulatePaid");
            const btnReturn = document.getElementById("btnReturn");
            const qrImage = document.getElementById("qr-image");

            // ==========================================
            // CẤU HÌNH THÔNG TIN NGÂN HÀNG CỦA BẠN TẠI ĐÂY
            // ==========================================
            const MY_BANK_ID = "MB"; // Tên viết tắt ngân hàng (VD: MB, VCB, TCB, ACB...)
            const MY_ACCOUNT_NO = "1508200456788"; // Số tài khoản của bạn
            const MY_ACCOUNT_NAME = "PHAM THE SON"; // Tên chủ tài khoản (Viết không dấu)
            const AMOUNT_TO_PAY = @totalToPay;
            const TRANSFER_MEMO = "Thanh toan phong " + @Model.BookingId;

            // Hàm sinh link VietQR
            function generateVietQRUrl() {
                // Định dạng compact2 sẽ cho ra QR có logo VietQR ở giữa rất đẹp
                return `https://img.vietqr.io/image/${MY_BANK_ID}-${MY_ACCOUNT_NO}-compact2.png?amount=${AMOUNT_TO_PAY}&addInfo=${encodeURIComponent(TRANSFER_MEMO)}&accountName=${encodeURIComponent(MY_ACCOUNT_NAME)}`;
            }

            // Hàm chuyển đổi giao diện dựa trên Radio button
            function toggleView() {
                if (rdoCash.checked) {
                    cashSection.style.display = "block";
                    qrSection.style.display = "none";
                    successSection.style.display = "none";
                } else if (rdoTransfer.checked) {
                    cashSection.style.display = "none";
                    qrSection.style.display = "block";
                    successSection.style.display = "none";
                    // Load mã QR
                    qrImage.src = generateVietQRUrl();
                }
            }

            // Lắng nghe sự kiện đổi phương thức thanh toán
            rdoCash.addEventListener("change", toggleView);
            rdoTransfer.addEventListener("change", toggleView);

            // 1. Xử lý khi bấm nút "Xác nhận Trả phòng (Tiền mặt)"
            btnCashSubmit.addEventListener("click", function () {
                if (confirm("Xác nhận khách đã thanh toán đủ tiền mặt?")) {
                    formCheckout.submit(); // Bắn form về Controller
                }
            });

            // 2. Xử lý khi xác nhận đã nhận chuyển khoản (Mô phỏng Webhook)
            btnSimulatePaid.addEventListener("click", function () {
                qrSection.style.display = "none";
                successSection.style.display = "block";
            });

            // 3. Xử lý khi ở màn hình Thành công bấm "Quay về danh sách"
            btnReturn.addEventListener("click", function () {
                formCheckout.submit(); // Bắn form về Controller để update Database
            });
        });
    </script>
}