@{
    ViewData["Title"] = "Chat với Admin";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm" style="height: 75vh; display: flex; flex-direction: column;">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0"><i class="bi bi-chat-left-text-fill me-2 text-primary"></i>Hệ thống Chat Nội bộ</h5>
            </div>

            <div id="chat-box" class="card-body p-4" style="flex-grow: 1; overflow-y: auto; background: #f8f9fa;">
                <div id="messagesList">
                    <div class="text-center text-muted my-3"><small>Bắt đầu cuộc trò chuyện với Admin</small></div>
                </div>
            </div>

            <div class="card-footer bg-white p-3 border-top">
                <div class="input-group">
                    <input type="text" id="messageInput" class="form-control border-0 bg-light" placeholder="Nhập nội dung tin nhắn..." aria-label="Recipient's username">
                    <button class="btn btn-primary px-4" type="button" id="sendButton">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .msg-item {
            margin-bottom: 15px;
            max-width: 70%;
            padding: 10px 15px;
            border-radius: 15px;
            position: relative;
        }

        .msg-me {
            background: #d4af37;
            color: white;
            align-self: flex-end;
            margin-left: auto;
            border-bottom-right-radius: 2px;
        }

        .msg-other {
            background: #e9ecef;
            color: #2b3674;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
        }

        .msg-time {
            font-size: 10px;
            display: block;
            margin-top: 5px;
            opacity: 0.8;
        }
    </style>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@6.0.1/dist/browser/signalr.min.js"></script>
    <script>
        $(document).ready(function () {
            // 1. KHỞI TẠO CONNECTION (BẮT BUỘC)
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .build();

            const $msgInput = $("#messageInput");
            const $msgList = $("#messagesList");
            const $chatBox = $("#chat-box");
            const currentUser = "@Context.Session.GetString("Username")";

            function showSendError(text) {
                const html = `<div class="text-danger small mb-2">${text}</div>`;
                $msgList.append(html);
                scrollToBottom();
            }

            function scrollToBottom() {
                $chatBox.scrollTop($chatBox[0].scrollHeight);
            }

            // 2. LẮNG NGHE TIN NHẮN
            connection.on("ReceiveMessage", function (user, message, time) {
                const isMe = user === currentUser;
                const msgHtml = `
                    <div class="msg-item ${isMe ? 'msg-me' : 'msg-other'}" style="margin-bottom: 10px; clear: both; overflow: hidden;">
                        <div style="float: ${isMe ? 'right' : 'left'}; background: ${isMe ? '#d4af37' : '#e9ecef'}; color: ${isMe ? 'white' : 'black'}; padding: 8px 15px; border-radius: 15px;">
                            <strong>${isMe ? 'Bạn' : user}</strong>: ${message}
                            <small style="display: block; font-size: 10px; opacity: 0.7;">${time}</small>
                        </div>
                    </div>`;

                $msgList.append(msgHtml);
                scrollToBottom();
            });

            // 3. BẮT ĐẦU KẾT NỐI
            connection.start().then(function () {
                console.log("SignalR Connected!");
                return connection.invoke("GetRecentMessages", 200);
            }).then(function (history) {
                if (!Array.isArray(history)) return;
                history.forEach(function (m) {
                    const isMe = m.user === currentUser;
                    const msgHtml = `
                        <div class="msg-item ${isMe ? 'msg-me' : 'msg-other'}" style="margin-bottom: 10px; clear: both; overflow: hidden;">
                            <div style="float: ${isMe ? 'right' : 'left'}; background: ${isMe ? '#d4af37' : '#e9ecef'}; color: ${isMe ? 'white' : 'black'}; padding: 8px 15px; border-radius: 15px;">
                                <strong>${isMe ? 'Bạn' : m.user}</strong>: ${m.message}
                                <small style="display: block; font-size: 10px; opacity: 0.7;">${m.time}</small>
                            </div>
                        </div>`;
                    $msgList.append(msgHtml);
                });
                scrollToBottom();
            }).catch(function (err) {
                return console.error("Lỗi kết nối: " + err.toString());
            });

            // 4. SỰ KIỆN GỬI TIN NHẮN
            $("#sendButton").click(function () {
                var message = $msgInput.val();
                if (message.trim() === "") return;

                // Kiểm tra trạng thái kết nối trước khi gửi
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SendMessage", currentUser, message)
                        .then(function () {
                            $msgInput.val("").focus();
                        })
                        .catch(function (err) {
                            console.error(err.toString());
                            showSendError("Gửi tin nhắn thất bại: " + err.toString());
                        });
                } else {
                    alert("Đang mất kết nối với máy chủ chat!");
                }
            });

            $msgInput.keypress(function (e) {
                if (e.which == 13) {
                    $("#sendButton").click();
                }
            });
        });
    </script>
}