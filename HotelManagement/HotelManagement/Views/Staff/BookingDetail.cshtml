@using HotelManagement.Models.Entities
@model HotelManagement.Models.ViewModels.BookingViewModel
@{
	ViewData["Title"] = "Chi tiết đặt phòng";
	Layout = "~/Views/Shared/_StaffLayout.cshtml";
    var hiddenPenaltyServiceIds = (ViewBag.HiddenPenaltyServiceIds as IEnumerable<int>)?.ToHashSet() ?? new HashSet<int>();

    bool IsAnyCustomPenalty(Service service)
    {
        return service.Name.StartsWith("[BOOKING:");
    }

    string GetDisplayPenaltyName(Service service, int bookingId)
    {
        var prefix = $"[BOOKING:{bookingId}]";
        return service.Name.StartsWith(prefix) ? service.Name[prefix.Length..] : service.Name;
    }
}

<div class="container-fluid py-4 ">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Chi tiết đặt phòng #@Model.BookingId</h2>
		<div>
			@* CHỈ HIỆN nút Nhận phòng khi trạng thái là Confirmed hoặc Pending *@
			@if (Model.Status == "Confirmed" || Model.Status == "Pending")
			{
				<a asp-controller="Staff" asp-action="CheckIn" asp-route-id="@Model.BookingId" class="btn btn-success shadow-sm me-2">
					<i class="fas fa-sign-in-alt"></i> Nhận phòng
				</a>
			}

			@* CHỈ HIỆN nút Trả phòng khi trạng thái là CheckedIn *@
			@if (Model.Status == "CheckedIn")
			{
				<a asp-controller="Staff" asp-action="CheckOut" asp-route-id="@Model.BookingId" class="btn btn-danger shadow-sm">
					<i class="fas fa-sign-out-alt"></i> Trả phòng
				</a>
			}
		</div>
	</div>

	<div class="card shadow border-0">
		<div class="card-body p-4">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning">@TempData["Warning"]</div>
            }

			<div class="row">
				<div class="col-md-6 border-end pe-md-4">

					<div class="mb-4">
						<h5 class="text-primary border-bottom pb-2">Thông tin Booking</h5>
						<p class="mb-2"><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
						<div class="d-flex align-items-center mt-3">
							<strong class="me-3">Trạng thái:</strong>

							@if (Model.Status == "Cancelled" || Model.Status == "CheckedOut" || Model.Status == "CheckedIn")
							{
								<span class="badge @(Model.Status == "Cancelled" ? "bg-danger" : Model.Status == "CheckedIn" ? "bg-success" : "bg-secondary")">
									@Model.Status
								</span>
							}
							else
							{
								<form method="post" asp-controller="Staff" asp-action="BookingDetail" asp-route-id="@Model.BookingId" class="d-flex w-50">
									<select class="form-select form-select-sm me-2" name="status">
										<option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed</option>
										<option value="Cancelled">Cancelled</option>
									</select>
									<button type="submit" class="btn btn-sm btn-primary">Cập nhật</button>
								</form>
							}
						</div>
					</div>

					<div class="mb-4">
						<h5 class="text-primary border-bottom pb-2">Thông tin Khách hàng</h5>
						<p class="mb-1"><strong>Họ tên:</strong> @Model.Customer?.FullName</p>
						<p class="mb-1"><strong>SĐT:</strong> <a href="tel:@Model.Customer?.Phone" class="text-decoration-none">@Model.Customer?.Phone</a></p>
						<p class="mb-0"><strong>Email:</strong> <a href="mailto:@Model.Customer?.Email" class="text-decoration-none">@Model.Customer?.Email</a></p>
					</div>

					<div>
						<h5 class="text-primary border-bottom pb-2">Thông tin Thanh toán</h5>
						@{
							int _nights = (Model.ExpectedCheckOut.Date - Model.ExpectedCheckIn.Date).Days;
							if (_nights <= 0) _nights = 1;
							decimal _roomTotal = (Model.Room?.Price ?? 0) * _nights;
							decimal _svcTotal = Model.Services?.Where(s => s.IsActive == true).Sum(s => s.Price) ?? 0;
                            decimal _surchargeTotal = Model.Services?.Where(s => s.IsActive == false).Sum(s => s.Price) ?? 0;
							decimal _grand = _roomTotal + _svcTotal + _surchargeTotal;
						}
						<p class="mb-1"><strong>Số đêm:</strong> @_nights đêm</p>
						<p class="mb-1"><strong>Tiền phòng:</strong> <span class="text-danger fw-bold">@_roomTotal.ToString("N0") VNĐ</span> <small class="text-muted">(@(Model.Room?.Price.ToString("N0")) × @_nights)</small></p>
						<p class="mb-1"><strong>Tiền dịch vụ:</strong> <span class="text-danger fw-bold">@_svcTotal.ToString("N0") VNĐ</span></p>
						<p class="mb-1"><strong>Phụ phí phát sinh:</strong> <span class="text-danger fw-bold">@_surchargeTotal.ToString("N0") VNĐ</span></p>
						<p class="mb-1"><strong>Tổng cộng (phòng + dịch vụ + phụ phí):</strong> <span class="text-danger fw-bold">@_grand.ToString("N0") VNĐ</span></p>
						@if (Model.Deposit == null || Model.Deposit == 0)
						{
							<p class="mb-0"><strong>Đặt cọc:</strong> <span class="badge bg-secondary">Thanh toán khi trả phòng</span></p>
						}
						else
						{
							decimal _remaining = _grand - (Model.Deposit ?? 0);
							<p class="mb-1"><strong>Đã đặt cọc:</strong> <span class="text-success fw-bold">@Model.Deposit?.ToString("N0") VNĐ</span></p>
							<p class="mb-0"><strong>Còn lại cần trả:</strong> <span class="text-warning fw-bold">@(_remaining > 0 ? _remaining.ToString("N0") : "0") VNĐ</span></p>
						}
					</div>

				</div>

                <div class="col-md-6 ps-md-4 mt-4 mt-md-0">
                    <div class="row mb-3 bg-light p-3 rounded">
                        <div class="col-6">
                            <span class="d-block text-muted small">Ngày nhận phòng</span>
                            <strong class="fs-5 text-primary">@Model.ExpectedCheckIn.ToString("dd/MM/yyyy")</strong>
                            <span class="d-block small text-muted">@Model.ExpectedCheckIn.ToString("HH:mm")</span>
                        </div>
                        <div class="col-6 border-start">
                            <span class="d-block text-muted small">Ngày trả phòng</span>
                            <strong class="fs-5 text-primary">@Model.ExpectedCheckOut.ToString("dd/MM/yyyy")</strong>
                            <span class="d-block small text-muted">@Model.ExpectedCheckOut.ToString("HH:mm")</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="text-primary border-bottom pb-2">Thông tin Phòng</h5>
                        <p class="mb-2"><strong>Số phòng:</strong> <span class="badge bg-info text-dark">@Model.Room?.RoomNumber</span></p>
                        <p class="mb-1"><strong>Loại phòng:</strong> @Model.Room?.RoomTypeName</p>
                        <p class="mb-1"><strong>Trạng thái:</strong> <span class="badge bg-secondary">@Model.Room?.Status</span></p>
                    </div>

                    @if (Model.Status == "CheckedIn")
                    {
                        // 1. Chuẩn bị dữ liệu
                        var usedServiceIds = Model.Services?.Select(s => s.ServiceId).ToHashSet() ?? new HashSet<int>();
                        var allServices = (ViewBag.Services as IEnumerable<Service>) ?? Enumerable.Empty<Service>();

                        // 2. Phân loại dịch vụ CHƯA SỬ DỤNG (Sửa logic lọc tại đây)
                        var availablePenalty = allServices
                            .Where(s => s.IsActive == false
                                && !usedServiceIds.Contains(s.ServiceId)
                                && !hiddenPenaltyServiceIds.Contains(s.ServiceId)
                                && !IsAnyCustomPenalty(s))
                            .ToList();
                        var availableRegular = allServices.Where(s => (s.IsActive == true) && !usedServiceIds.Contains(s.ServiceId)).ToList();

						<div class="mb-4">
							<h5 class="text-primary border-bottom pb-2"><i class="fas fa-exclamation-triangle"></i> Phụ phí phát sinh</h5>

							@* Hiển thị phụ phí ĐÃ CÓ (giữ nguyên phần này) *@
							@foreach (var svc in Model.Services?.Where(s => s.IsActive == false) ?? Enumerable.Empty<Service>())
							{
								<div class="d-flex justify-content-between align-items-center mb-1 text-muted">
									<div>
										<i class="fas fa-check-circle text-danger me-2"></i>
										<span>@GetDisplayPenaltyName(svc, Model.BookingId) - <strong>@svc.Price.ToString("N0") VNĐ</strong></span>
									</div>
									<form method="post" asp-controller="Staff" asp-action="DeletePenaltyService" class="ms-3">
										@Html.AntiForgeryToken()
										<input type="hidden" name="bookingId" value="@Model.BookingId" />
										<input type="hidden" name="serviceId" value="@svc.ServiceId" />
										<button type="submit" class="btn btn-link btn-sm text-danger text-decoration-none p-0">Xóa</button>
									</form>
								</div>
							}

                            <form method="post" asp-controller="Staff" asp-action="AddPenaltyService" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <div class="row g-2 align-items-stretch">
                                    <div class="col-md-7">
                                        <input type="text" name="penaltyName" class="form-control" maxlength="100" placeholder="Vi du: Hong quat, gay giuong, mat khan..." />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" name="penaltyPrice" class="form-control" min="1000" step="1000" placeholder="So tien" />
                                    </div>
                                    <div class="col-md-2 d-grid">
                                        <button type="submit" class="btn btn-danger">Thêm</button>
                                    </div>
                                </div>
                            </form>

                            @* Danh sách chọn thêm Phụ phí *@
                            @if (availablePenalty.Any())
                            {
                                <form method="post" asp-controller="Staff" asp-action="UpdateServices" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                    <div class="row">
                                        @foreach (var x in availablePenalty)
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="form-check">
                                                    <input type="checkbox" name="selectedServiceIds" value="@x.ServiceId" class="form-check-input svc-check" data-price="@x.Price" id="pen_@x.ServiceId" />
                                                    <label class="form-check-label" for="pen_@x.ServiceId">@GetDisplayPenaltyName(x, Model.BookingId) (@x.Price.ToString("N0"))</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <button type="submit" class="btn btn-outline-danger btn-sm mt-1">Cập nhật phụ phí</button>
                                </form>
                            }
                            else if (!(Model.Services?.Any(s => s.IsActive == false) ?? false))
                            {
                                <p class="text-muted small">Chưa có phụ phí.</p>
                            }
                        </div>

                        <div class="mb-3">
                            <h5 class="text-primary border-bottom pb-2"><i class="fas fa-concierge-bell"></i> Dịch vụ đi kèm</h5>

                            @* Dịch vụ ĐÃ ĐĂNG KÝ *@
                            @if (Model.Services?.Any(s => s.IsActive == true) ?? false)
                            {
                                <div class="small text-uppercase text-muted fw-bold mb-2">Da dang ky</div>
                            }

                            @foreach (var svc in Model.Services?.Where(s => s.IsActive == true) ?? Enumerable.Empty<Service>())
                            {
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <span>@svc.Name - <strong class="text-success">@svc.Price.ToString("N0") VNĐ</strong></span>
                                </div>
                            }

                            @* Danh sách chọn thêm Dịch vụ *@
                            @if (availableRegular.Any())
                            {
                                <form method="post" asp-controller="Staff" asp-action="UpdateServices" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                    <div class="bg-light p-3 rounded">
                                        <div class="small text-uppercase text-muted fw-bold mb-2">Chon them dich vu</div>
                                        <div class="row">
                                            @foreach (var x in availableRegular)
                                            {
                                                <div class="col-md-6 mb-2">
                                                    <div class="form-check">
                                                        <input type="checkbox" name="selectedServiceIds" value="@x.ServiceId" class="form-check-input svc-check" data-price="@x.Price" id="svc_@x.ServiceId" />
                                                        <label class="form-check-label" for="svc_@x.ServiceId">@x.Name (@x.Price.ToString("N0"))</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                            <small>Tổng cộng thêm: <strong class="text-danger" id="newSvcTotal">0 VNĐ</strong></small>
                                            <button type="submit" class="btn btn-primary btn-sm">Cập nhật dịch vụ</button>
                                        </div>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">Vui lòng Check-in để quản lý phụ phí và dịch vụ.</div>
                    }
                </div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const checks = document.querySelectorAll(".svc-check");
			const newSvcTotalEl = document.getElementById("newSvcTotal");

			if (!checks.length || !newSvcTotalEl) return;

			function recalc() {
				let total = 0;
				checks.forEach(cb => {
					if (cb.checked) total += parseFloat(cb.dataset.price) || 0;
				});
				newSvcTotalEl.textContent = total.toLocaleString("vi-VN") + " VNĐ";
			}

			checks.forEach(cb => cb.addEventListener("change", recalc));
		});
	</script>
}
