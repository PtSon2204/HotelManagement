@model HotelManagement.Models.ViewModels.DirectBookingViewModel

@{
    ViewData["Title"] = "Đặt phòng trực tiếp";
    var room = ViewBag.Room as HotelManagement.Models.Entities.Room;
    var services = ViewBag.Services as List<HotelManagement.Models.Entities.Service> ?? new List<HotelManagement.Models.Entities.Service>();
    bool isRoomLocked = ViewBag.IsRoomLocked == true;
}

<style>
    :root {
        --primary: #1a1a2e;
        --accent: #d4af37;
        --bg-light: #f8fafc;
        --border-color: #e2e8f0;
    }

    .booking-hero {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        padding: 3rem 0;
        color: #fff;
        margin-bottom: 2rem;
    }
    .booking-hero h1 { font-family: 'Playfair Display', serif; color: var(--accent); font-size: 2.2rem; }

    /* ────── Account Info (Fixed) ────── */
    .account-summary {
        background: #f1f5f9;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        border-left: 5px solid var(--accent);
    }
    .account-summary i { font-size: 2rem; color: var(--primary); opacity: 0.2; }
    .account-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 2px; }
    .account-val { font-weight: 700; color: var(--primary); font-size: 1rem; }

    /* ────── Sections ────── */
    .booking-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid var(--border-color);
    }
    .section-title {
        font-size: 0.85rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: 1.5px; color: var(--accent);
        margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, #e2e8f0, transparent); }

    /* ────── Saved Profile Picker (Shopee-style) ────── */
    .profile-picker-btn {
        background: #fffbeb;
        border: 1px dashed var(--accent);
        color: #92400e;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .profile-picker-btn:hover { background: #fef3c7; border-style: solid; }

    #savedProfilesList {
        display: none;
        position: absolute;
        z-index: 1000;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        border: 1px solid var(--border-color);
        width: 320px;
        margin-top: 5px;
        max-height: 400px;
        overflow-y: auto;
    }
    .profile-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        transition: background 0.15s;
    }
    .profile-item:last-child { border-bottom: none; }
    .profile-item:hover { background: #f8fafc; }
    .profile-item .label { font-weight: 700; color: var(--accent); font-size: 0.75rem; text-transform: uppercase; }
    .profile-item .name { font-weight: 700; color: var(--primary); display: block; }
    .profile-item .phone { color: #64748b; font-size: 0.85rem; }

    /* ────── Form Controls ────── */
    .form-label { font-weight: 600; color: #475569; font-size: 0.9rem; margin-bottom: 0.5rem; }
    .form-control-lg { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: 1rem; padding: 0.75rem 1rem; }
    .form-control-lg:focus { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1); }

    /* ────── Payment Options ────── */
    .pay-option {
        border: 2px solid #f1f5f9;
        border-radius: 14px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .pay-option.active { border-color: var(--accent); background: #fffdf5; }
    .pay-option .title { font-weight: 700; color: var(--primary); font-size: 1.1rem; margin-bottom: 0.5rem; }
    .pay-option .desc { font-size: 0.85rem; color: #64748b; line-height: 1.4; }
    .discount-badge { background: #16a34a; color: #fff; font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 4px; position: absolute; top: -10px; right: 15px; }

    /* ────── Sidebar ────── */
    .price-sidebar { position: sticky; top: 100px; }
    .price-box {
        background: var(--primary);
        color: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    }
    .price-row { display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.9rem; color: rgba(255,255,255,0.6); }
    .price-total { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem; margin-top: 1rem; display: flex; justify-content: space-between; align-items: center; }
    .total-val { font-size: 1.8rem; font-weight: 800; color: var(--accent); }

    .btn-book {
        background: linear-gradient(135deg, #d4af37 0%, #f0c940 100%);
        border: none; color: #1a1a2e; font-weight: 800; font-size: 1.1rem;
        padding: 1.2rem; border-radius: 12px; width: 100%; margin-top: 1.5rem;
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4); transition: transform 0.2s;
    }
    .btn-book:hover { transform: translateY(-3px); color: #1a1a2e; }

    /* ─── Toggle Switch ─── */
    .toggle-group { display: flex; align-items: center; gap: 10px; background: #f8fafc; padding: 10px 15px; border-radius: 10px; border: 1px solid #e2e8f0; }
    .switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
    input:checked + .slider { background-color: var(--accent); }
    input:checked + .slider:before { transform: translateX(20px); }
</style>

<div class="booking-hero">
    <div class="container">
        <h1 class="mb-2"><i class="fas fa-calendar-check me-2"></i> Đặt Phòng Trải Nghiệm</h1>
        <p class="mb-0 text-white-50">Marian Hotel — Nơi khởi đầu cho kỳ nghỉ tuyệt vời của bạn</p>
    </div>
</div>

<div class="container pb-5">
    <!-- 1. ACCOUNT SUMMARY (Fixed) -->
    <div class="account-summary">
        <i class="fas fa-user-circle"></i>
        <div class="d-flex gap-4">
            <div>
                <div class="account-label">Tài khoản đặt</div>
                <div class="account-val">@Model.AccountName</div>
            </div>
            <div>
                <div class="account-label">Số điện thoại</div>
                <div class="account-val">@Model.AccountPhone</div>
            </div>
            <div class="d-flex align-items-center ms-3">
                <span class="badge bg-secondary opacity-75 small">Account Owner</span>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3 mt-3 mb-4 d-flex align-items-center">
            <i class="fas fa-exclamation-triangle fs-4 me-3 text-danger"></i>
            <div>
                <h6 class="mb-1 fw-bold text-danger">Không thể gửi đơn</h6>
                <div class="small">@TempData["Error"]</div>
            </div>
        </div>
    }

    <form asp-action="Create" method="post" id="bookingForm" class="row">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoomId" id="roomIdInput" />
        <input type="hidden" asp-for="PaymentOption" id="paymentOptionInput" value="Deposit" />
        <input type="hidden" asp-for="GuestProfileId" id="guestProfileIdInput" />
        <input type="hidden" asp-for="NumberOfPeople" />

        <!-- LEFT: Form -->
        <div class="col-lg-8">
            
            <!-- THÔNG TIN KHÁCH (GUEST) -->
            <div class="booking-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title mb-0"><i class="fas fa-id-card"></i> Thông tin người ở thực tế</div>
                    
                    <!-- Profile Picker (Shopee style) -->
                    <div class="position-relative">
                        <div class="profile-picker-btn" id="profilePickerTrigger">
                            <i class="fas fa-address-book"></i> Chọn hồ sơ đã lưu
                        </div>
                        <div id="savedProfilesList">
                            <!-- JS renders items here -->
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Họ và tên khách <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-lg" id="guestName" placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Số điện thoại khách <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control form-control-lg" id="guestPhone" placeholder="Ví dụ: 0901234567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg" id="guestEmail" placeholder="email@example.com" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdCard" class="form-label">CMND / CCCD</label>
                        <input asp-for="IdCard" class="form-control form-control-lg" id="guestIdCard" placeholder="012345678901" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label">Giới tính</label>
                        <select asp-for="Gender" class="form-control form-control-lg" id="guestGender">
                            <option value="">-- Chọn --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Nationality" class="form-label">Quốc tịch</label>
                        <input asp-for="Nationality" class="form-control form-control-lg" id="guestNat" placeholder="Việt Nam" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Address" class="form-label">Địa chỉ</label>
                        <input asp-for="Address" class="form-control form-control-lg" id="guestAddr" placeholder="Hà Nội" />
                    </div>
                </div>

                <!-- SAVE PROFILE TOGGLE -->
                <div class="mt-4 d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-3">
                        <div class="toggle-group p-0 border-0 bg-transparent">
                            <label class="switch">
                                <input type="checkbox" id="saveProfileCheck" asp-for="SaveProfile">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="small">
                            <div class="fw-bold">Lưu thông tin khách này</div>
                            <div class="text-muted">Để sử dụng nhanh cho các lần đặt sau (Lưu trên máy này)</div>
                        </div>
                    </div>
                    <div id="labelGroup" style="display:none; width: 220px;">
                        <input type="text" asp-for="GuestLabel" class="form-control form-control-sm" 
                               placeholder="Lưu tên (VD: Ba, Vợ, ...)" id="profileLabelInput" />
                    </div>
                </div>
            </div>

            <!-- THỜI GIAN & DỊCH VỤ -->
            <div class="booking-card">
                <div class="section-title"><i class="fas fa-clock"></i> Thời gian & Dịch vụ</div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">Ngày nhận phòng</label>
                        <input asp-for="CheckInDate" type="date" class="form-control form-control-lg" id="checkInDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày trả phòng</label>
                        <input asp-for="CheckOutDate" type="date" class="form-control form-control-lg" id="checkOutDate" />
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <label class="form-label mb-3 d-block">Dịch vụ đi kèm</label>
                    <div class="row g-2">
                        @foreach (var s in services)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="form-check p-3 border rounded-3 h-100">
                                    <input class="form-check-input ms-0 me-2 svc-check" type="checkbox" name="SelectedServiceIds" 
                                           value="@s.ServiceId" data-price="@s.Price" id="svc_@s.ServiceId">
                                    <label class="form-check-label d-flex justify-content-between align-items-center" for="svc_@s.ServiceId">
                                        <span>@s.Name</span>
                                        <span class="text-success small fw-bold">+@s.Price.ToString("N0")</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- PHƯƠNG THỨC THANH TOÁN -->
            <div class="booking-card border-0 p-0 shadow-none">
                <div class="section-title"><i class="fas fa-credit-card"></i> Hình thức đặt phòng</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="pay-option active position-relative" data-val="Deposit" onclick="setPay('Deposit', this)">
                            <div>
                                <div class="title">Cọc 50%</div>
                                <div class="desc">Thanh toán một nửa để giữ chỗ. Phần còn lại thanh toán khi nhận phòng.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="pay-option position-relative" data-val="Full" onclick="setPay('Full', this)">
                            <span class="discount-badge">GIẢM 7% 🔥</span>
                            <div>
                                <div class="title">Thanh toán 100%</div>
                                <div class="desc">Thanh toán toàn bộ ngay bây giờ để được chiết khấu ưu đãi 7% tổng hóa đơn.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT: Sidebar Info -->
        <div class="col-lg-4">
            <div class="price-sidebar">
                @if (room != null)
                {
                    <div class="booking-card mb-3 p-3">
                        <div class="d-flex gap-3">
                            <img src="@(room.Images?.FirstOrDefault()?.Url ?? "/assets/img/rooms/room1.jpg")" style="width:100px; height:80px; object-fit:cover; border-radius:8px;" />
                            <div>
                                <h6 class="mb-1 fw-bold">Phòng @room.RoomNumber</h6>
                                <div class="text-muted small">@room.RoomTypeName</div>
                                <div class="fw-bold text-success">@room.Price.ToString("N0") VNĐ / Đêm</div>
                            </div>
                        </div>
                    </div>
                }

                <div class="price-box">
                    <div class="price-row">
                        <span>Giá phòng (<span id="nightCount">1</span> đêm)</span>
                        <span id="roomSubtotal">0 VNĐ</span>
                    </div>
                    <div class="price-row">
                        <span>Dịch vụ cộng thêm</span>
                        <span id="serviceSubtotal">0 VNĐ</span>
                    </div>
                    <div class="price-row" id="discountRow" style="display:none;">
                        <span class="text-success">Giảm giá thành viên (7%)</span>
                        <span id="discountVal" class="text-success">-0 VNĐ</span>
                    </div>
                    <div class="price-total">
                        <div class="text-white-50 small">TỔNG HÓA ĐƠN</div>
                        <div class="total-val" id="grandTotal">0 VNĐ</div>
                    </div>

                    <div class="price-row mt-4 pt-4 border-top border-secondary">
                        <span id="payLabel">Số tiền trả ngay (Cọc 50%)</span>
                        <span id="amountToPay" class="fs-4 fw-bold text-white">0 VNĐ</span>
                    </div>
                    <div class="price-row mt-4 pt-4 border-top border-secondary">
                        <a asp-action="PrivacyHotel" asp-controller="Booking" target="_blank"> Chính sách & điều khoản</a>
                    </div>

                    <button type="submit" class="btn-book" onclick="return handleBeforeSubmit();">
                        TIẾP TỤC THANH TOÁN <i class="fas fa-chevron-right ms-2 fs-6"></i>
                    </button>
                    <p class="text-center mt-3 small text-white-50">An toàn • Nhanh chóng • Không ẩn phí</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    var basePrice = @(((room?.Price ?? Model.Price) ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
    var currentPayment = 'Deposit';

    // ─── Guest Profile Logic ───
    const savedProfiles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SavedProfiles ?? new object[0]));

    function renderPicker() {
        const list = document.getElementById('savedProfilesList');
        if (!savedProfiles || savedProfiles.length === 0) {
            list.innerHTML = '<div class="p-3 text-muted text-center small">Chưa có hồ sơ nào được lưu.</div>';
            return;
        }

        list.innerHTML = savedProfiles.map((p, i) => `
            <div class="profile-item" onclick="selectProfile(${i})">
                <div class="label">${p.Label || 'Khách'}</div>
                <div class="name">${p.FullName}</div>
                <div class="phone"><i class="fas fa-phone-alt me-1"></i>${p.Phone}</div>
            </div>
        `).join('');
    }

    function selectProfile(index) {
        const p = savedProfiles[index];
        if (!p) return;

        document.getElementById('guestProfileIdInput').value = p.ProfileId;
        document.getElementById('guestName').value = p.FullName;
        document.getElementById('guestPhone').value = p.Phone;
        document.getElementById('guestEmail').value = p.Email || '';
        document.getElementById('guestIdCard').value = p.IdCard || '';
        document.getElementById('guestGender').value = p.Gender || '';
        document.getElementById('guestNat').value = p.Nationality || '';
        document.getElementById('guestAddr').value = p.Address || '';
        
        document.getElementById('savedProfilesList').style.display = 'none';
        
        // Trigger CSS color change (optional)
        document.querySelectorAll('.booking-card input, .booking-card select').forEach(el => {
            if (el.value) el.style.borderBottom = '2px solid #22c55e';
        });
    }

    function handleBeforeSubmit() {
        return true;
    }

    // Reset ID if user modifies inputs manually after selecting a profile
    document.querySelectorAll('#guestName, #guestPhone, #guestEmail, #guestIdCard, #guestGender, #guestNat, #guestAddr').forEach(el => {
        el.addEventListener('input', function() {
            document.getElementById('guestProfileIdInput').value = '';
        });
    });

    // Toggle label input visibility
    document.getElementById('saveProfileCheck').addEventListener('change', function() {
        document.getElementById('labelGroup').style.display = this.checked ? 'block' : 'none';
    });

    // Picker visibility
    document.getElementById('profilePickerTrigger').addEventListener('click', function(e) {
        e.stopPropagation();
        const list = document.getElementById('savedProfilesList');
        const isHidden = list.style.display !== 'block';
        list.style.display = isHidden ? 'block' : 'none';
        if (isHidden) renderPicker();
    });

    document.addEventListener('click', function() {
        document.getElementById('savedProfilesList').style.display = 'none';
    });

    // ─── Price Calculation Logic ───
    function setPay(val, el) {
        currentPayment = val;
        document.getElementById('paymentOptionInput').value = val;
        document.querySelectorAll('.pay-option').forEach(x => x.classList.remove('active'));
        el.classList.add('active');
        recalculate();
    }

    function recalculate() {
        var ci = new Date(document.getElementById('checkInDate').value);
        var co = new Date(document.getElementById('checkOutDate').value);
        
        var diff = (co - ci) / (1000 * 60 * 60 * 24);
        var nights = diff > 0 ? diff : 1;
        document.getElementById('nightCount').innerText = Math.round(nights);

        var roomSub = basePrice * nights;
        document.getElementById('roomSubtotal').innerText = roomSub.toLocaleString() + ' VNĐ';

        var svcSub = 0;
        document.querySelectorAll('.svc-check:checked').forEach(cb => {
            svcSub += parseFloat(cb.dataset.price);
        });
        document.getElementById('serviceSubtotal').innerText = svcSub.toLocaleString() + ' VNĐ';

        var grand = roomSub + svcSub;
        var discount = 0;

        if (currentPayment === 'Full') {
            discount = grand * 0.07;
            document.getElementById('discountRow').style.display = 'flex';
            document.getElementById('discountVal').innerText = '-' + discount.toLocaleString() + ' VNĐ';
        } else {
            document.getElementById('discountRow').style.display = 'none';
        }

        var final = grand - discount;
        document.getElementById('grandTotal').innerText = final.toLocaleString() + ' VNĐ';

        var toPay = (currentPayment === 'Full') ? final : (final / 2);
        document.getElementById('amountToPay').innerText = toPay.toLocaleString() + ' VNĐ';
        document.getElementById('payLabel').innerText = (currentPayment === 'Full') ? 'Số tiền trả ngay (100%)' : 'Số tiền trả ngay (Cọc 50%)';
    }

    // Init dates and trigger calc
    (function init() {
        var today = new Date();
        var d1 = new Date(today); d1.setDate(d1.getDate() + 1);
        var d2 = new Date(today); d2.setDate(d2.getDate() + 2);

        var ci = document.getElementById('checkInDate');
        var co = document.getElementById('checkOutDate');
        if (!ci.value) ci.value = d1.toISOString().split('T')[0];
        if (!co.value) co.value = d2.toISOString().split('T')[0];

        ci.addEventListener('change', function() {
            var v1 = new Date(this.value);
            var v2 = new Date(co.value);
            if (v2 <= v1) {
                var next = new Date(v1); next.setDate(next.getDate() + 1);
                co.value = next.toISOString().split('T')[0];
            }
            recalculate();
        });
        co.addEventListener('change', recalculate);
        document.querySelectorAll('.svc-check').forEach(x => x.addEventListener('change', recalculate));
        
        recalculate();
        renderPicker();
    })();

            function handleBeforeSubmit() {
            const name = document.getElementById('guestName').value.trim();
            const phone = document.getElementById('guestPhone').value.trim();

            if (!name || !phone) {
                alert("Vui lòng điền đầy đủ Họ tên và Số điện thoại khách hàng!");
                return false;
            }

            // Nếu thông tin đã ổn, mới hiện confirm điều khoản
            return window.confirm("Tôi đồng ý với các điều khoản. Ấn OK để tiếp tục thanh toán.");
        }
</script>
}