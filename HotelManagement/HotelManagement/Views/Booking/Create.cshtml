@model HotelManagement.Models.ViewModels.DirectBookingViewModel

@{
    ViewData["Title"] = "Đặt phòng trực tiếp";
}

<div class="luxury-bg-wrapper">
    <div class="particle p1"></div>
    <div class="particle p2"></div>
    <div class="particle p3"></div>
    <div class="particle p4"></div>
    <div class="particle p5"></div>
    <div class="particle p6"></div>
    <div class="particle p7"></div>
</div>

<div class="form-container-wrapper row justify-content-center mt-5 mb-5">
    <div class="col-md-10">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white p-4">
                <h3 class="mb-0"><i class="fas fa-bed"></i> Đặt phòng trực tuyến</h3>
                <p class="mb-0">Vui lòng điền đầy đủ thông tin để hoàn tất việc đặt phòng.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                    <h5 class="text-secondary border-bottom pb-2 mb-3">Thông tin khách hàng</h5>
                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="FullName" class="font-weight-bold">Họ và tên *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên đầy đủ..." />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Phone" class="font-weight-bold">Số điện thoại *</label>
                            <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="Email" class="font-weight-bold">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email..." />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="IdCard" class="font-weight-bold">Số CMND/CCCD</label>
                            <input asp-for="IdCard" class="form-control" placeholder="Nhập số giấy tờ pháp lý..." />
                            <span asp-validation-for="IdCard" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 form-group">
                            <label asp-for="Gender" class="font-weight-bold">Giới tính</label>
                            <select asp-for="Gender" class="form-control">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="Nationality" class="font-weight-bold">Quốc tịch</label>
                            <input asp-for="Nationality" class="form-control" placeholder="Ví dụ: Việt Nam..." />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="Address" class="font-weight-bold">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" placeholder="Nhập quê quán/địa chỉ..." />
                        </div>
                    </div>

                    <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Thông tin đặt phòng</h5>
                    <input type="hidden" asp-for="StaffId" />

                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="RoomId" class="font-weight-bold">Chọn Phòng *</label>
                            @if (ViewBag.IsRoomLocked == true)
                            {
                                <select asp-for="RoomId" class="form-control" asp-items="ViewBag.Rooms" style="pointer-events: none; background-color: #e9ecef;" tabindex="-1" readonly>
                                </select>
                                <input type="hidden" asp-for="RoomId" />
                            }
                            else
                            {
                                <select asp-for="RoomId" class="form-control" asp-items="ViewBag.Rooms">
                                    <option value="">-- Chọn phòng --</option>
                                </select>
                            }
                            <span asp-validation-for="RoomId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="NumberOfPeople" class="font-weight-bold">Số lượng khách *</label>
                            @if (ViewBag.FixedCapacity != null)
                            {
                                <input asp-for="NumberOfPeople" type="number" class="form-control" readonly tabindex="-1" style="pointer-events: none; background-color: #e9ecef;" />
                            }
                            else
                            {
                                <input asp-for="NumberOfPeople" type="number" min="1" class="form-control" />
                            }
                            <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 form-group">
                            <label asp-for="CheckInDate" class="font-weight-bold">Ngày nhận phòng dự kiến *</label>
                            <input asp-for="CheckInDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="CheckInDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="CheckOutDate" class="font-weight-bold">Ngày trả phòng dự kiến *</label>
                            <input asp-for="CheckOutDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                        </div>
                    </div>

                    <h5 class="text-secondary border-bottom pb-2 mb-3 mt-4">Dịch vụ đi kèm (Tùy chọn)</h5>
                    <div class="row mb-4">
                        @if (ViewBag.Services != null)
                        {
                            foreach (var service in ViewBag.Services)
                            {
                                <div class="col-md-4 form-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedServiceIds" value="@service.ServiceId" id="service_@service.ServiceId">
                                        <label class="form-check-label" for="service_@service.ServiceId">
                                            @service.Name (VND @service.Price?.ToString("N0"))
                                        </label>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted col-12">Hiện không có dịch vụ ngoại vi.</p>
                        }
                    </div>

                    <div class="form-group text-right mt-4 pt-3 border-top">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mr-2 px-4 py-2">Hủy quay về</a>
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="fas fa-check-circle"></i> Hoàn tất đặt phòng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}