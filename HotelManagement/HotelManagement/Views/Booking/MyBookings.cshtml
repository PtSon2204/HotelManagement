@model IEnumerable<HotelManagement.Models.Entities.Booking>

@{
    ViewData["Title"] = "Lịch sử Đặt phòng";
}

<div class="container mt-5 mb-5 pb-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="font-weight-bold" style="color: #d4a037;"><i class="fas fa-history"></i> Lịch sử Đặt phòng của tôi</h2>
            <p class="text-muted">Danh sách các phòng bạn đã đặt và trạng thái hiện tại.</p>
        </div>
        <div class="col-md-4 text-right">
            <a href="/Home/Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại Trang chủ
            </a>
        </div>
    </div>

    @if (TempData["BookingSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show font-weight-bold" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["BookingSuccess"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 text-center">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Mã Đặt</th>
                                <th>Phòng</th>
                                <th>Ngày Nhận</th>
                                <th>Ngày Trả</th>
                                <th>Số Khách</th>
                                <th>Ngày Tạo</th>
                                <th>Dịch vụ đính kèm</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var room = item.RoomBookings.FirstOrDefault()?.Room;
                                var roomNumber = room != null ? room.RoomNumber : "N/A";
                                var roomTypeName = room?.RoomType != null ? room.RoomType.Name : "";
                                
                                <tr>
                                    <td class="font-weight-bold align-middle">#@item.BookingId</td>
                                    <td class="align-middle">
                                        <span class="font-weight-bold text-dark">@roomNumber</span>
                                        @if(!string.IsNullOrEmpty(roomTypeName))
                                        {
                                            <div class="small text-muted">@roomTypeName</div>
                                        }
                                    </td>
                                    <td class="align-middle">@item.CheckIn.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="align-middle">@item.CheckOut.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="align-middle">@item.NumOfPeople người</td>
                                    <td class="align-middle">@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="align-middle">
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge badge-warning p-2">Đang chờ</span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge badge-primary p-2">Đã xác nhận</span>
                                        }
                                        else if (item.Status == "CheckedIn")
                                        {
                                            <span class="badge badge-success p-2">Đang sử dụng</span>
                                        }
                                        else if (item.Status == "CheckedOut")
                                        {
                                            <span class="badge badge-secondary p-2">Đã trả phòng</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge badge-danger p-2">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info p-2">@item.Status</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        @if (item.BookingServices.Any())
                                        {
                                            <ul class="list-unstyled mb-0 small text-left" style="display:inline-block;">
                                                @foreach(var svc in item.BookingServices)
                                                {
                                                    <li>- @(svc.Service?.Name ?? "Dịch vụ")</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Không có</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        @if (item.Status == "CheckedOut")
                                        {
                                            <a href="/Feedback/Create" class="btn btn-sm btn-outline-warning" title="Đánh giá chất lượng">
                                                <i class="fas fa-star"></i> Đánh giá
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <h4 class="text-muted"><i class="fas fa-search"></i> Bạn chưa có lịch sử đặt phòng nào!</h4>
                    <p class="mt-3">Hãy dạo quanh các phòng của khách sạn và đặt cho mình một phòng ưng ý nhé.</p>
                    <a href="/Home/Index" class="btn btn-primary mt-2 px-4" style="background-color: #d4a037; border-color: #d4a037;">
                        <i class="fas fa-mouse-pointer"></i> Khám phá phòng ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["BookingSuccess"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: 'Thành công!',
                    text: '@Html.Raw(TempData["BookingSuccess"])',
                    icon: 'success',
                    confirmButtonText: 'Tuyệt vời',
                    confirmButtonColor: '#d4a037'
                });
            });
        </script>
    }
}
