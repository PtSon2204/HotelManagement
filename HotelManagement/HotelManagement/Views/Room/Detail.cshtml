@using System.Collections.Generic
@model HotelManagement.Models.ViewModels.RoomViewModel

@{
    ViewData["Title"] = "Chi tiết phòng";
    Layout = null;
    var imgs = Model.ImageUrls != null && Model.ImageUrls.Count > 0
        ? Model.ImageUrls
        : (string.IsNullOrWhiteSpace(Model.Image)
            ? new List<string> { "/assets/img/rooms/room1.jpg" }
            : new List<string> { Model.Image });

    string? role = Context.Session.GetString("Role");
    string? username = Context.Session.GetString("Username");
    bool isStaff = role == "Staff";
    bool canSubmitFeedback = ViewBag.CanSubmitFeedback is bool canPost && canPost;
    string? feedbackEligibilityMessage = ViewBag.FeedbackEligibilityMessage as string;

    string DisplayStatus(string? s) => string.IsNullOrEmpty(s) ? "—" : s.Trim() switch
    {
        "Tr?ng" or "Available" => "Trống",
        "Booked" => "Đã đặt",
        "Occupied" => "Đang sử dụng",
        "Maintenance" => "Bảo trì",
        _ => s!
    };

    string RenderStars(int? rating)
    {
        var safeRating = Math.Clamp(rating ?? 0, 0, 5);
        return new string('★', safeRating) + new string('☆', 5 - safeRating);
    }
}

<!doctype html>
<html class="no-js" lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Phòng @Model.RoomNumber - Hotel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.ico">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
    <style>
        :root {
        --room-gold: #d4a037;
        --room-gold-hover: #b8922f;
        --room-price: #198754;
        --room-text-muted: #6c757d;
        --room-title: #1a1a2e;
        }

        .room-detail-back {
        background: var(--room-gold);
        color: #fff !important;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: background .2s ease;
        }
        .room-detail-back:hover { background: var(--room-gold-hover); color: #fff !important; }

        .room-detail-main-img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 12px;
        background: #f0f0f0;
        }

        .room-detail-thumb {
        border: 2px solid transparent;
        border-radius: 8px;
        overflow: hidden;
        display: inline-block;
        cursor: pointer;
        transition: border-color .2s;
        }
        .room-detail-thumb.active { border-color: var(--room-gold); }
        .room-detail-thumb img { width: 88px; height: 66px; object-fit: cover; display: block; }

        .room-detail-panel {
        background: #fff;
        border-radius: 12px;
        padding: 28px 24px;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 24px rgba(0,0,0,.06);
        }

        .room-detail-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--room-title);
        margin-bottom: 1.25rem;
        }

        .room-detail-line {
        color: var(--room-text-muted);
        font-size: .95rem;
        margin-bottom: .65rem;
        }
        .room-detail-line strong { color: #495057; font-weight: 600; }

        .room-detail-price {
        color: var(--room-price) !important;
        font-size: 1.25rem;
        font-weight: 700;
        }

        .room-detail-actions {
        margin-top: auto;
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 12px;
        }

        .room-detail-btn-gold {
        background: var(--room-gold);
        color: #fff !important;
        border: none;
        border-radius: 8px;
        padding: 12px 20px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: background .2s ease;
        }
        .room-detail-btn-gold:hover { background: var(--room-gold-hover); color: #fff !important; }

        .room-desc-box {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 20px 24px;
        background: #fafafa;
        margin-top: 2rem;
        }
        .room-desc-box h4 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--room-title);
        margin-bottom: 12px;
        }
        .room-desc-box p {
        margin: 0;
        color: #444;
        line-height: 1.7;
        white-space: pre-wrap;
        }

        .feedback-box {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 20px 24px;
        background: #fff;
        margin-top: 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.04);
        }

        .feedback-summary {
        display: flex;
        gap: 24px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 18px;
        padding-bottom: 18px;
        border-bottom: 1px solid #ececec;
        }

        .feedback-score {
        font-size: 2rem;
        font-weight: 700;
        color: var(--room-title);
        }

        .feedback-stars {
        color: #f0ad4e;
        letter-spacing: 1px;
        font-size: 1rem;
        }

        .feedback-item {
        padding: 16px 0;
        border-bottom: 1px solid #f1f1f1;
        }

        .feedback-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
        }

        .feedback-name {
        font-weight: 700;
        color: var(--room-title);
        }

        .feedback-date {
        color: var(--room-text-muted);
        font-size: .9rem;
        }

        .feedback-comment {
        color: #444;
        line-height: 1.7;
        white-space: pre-wrap;
        margin-top: 8px;
        }

        .feedback-form {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 20px 24px;
        background: #fafafa;
        margin-top: 2rem;
        }

        .feedback-form textarea {
        min-height: 120px;
        resize: vertical;
        }
    </style>
</head>

<body class="bg-white">
    <header>
        <div class="header-area header-sticky">
            <div class="main-header">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-2 col-lg-2">
                            <div class="logo">
                                <a href="/Home/Index"><img src="/assets/img/logo/logo.png" alt=""></a>
                            </div>
                        </div>
                        <div class="col-xl-8 col-lg-8">
                            <div class="main-menu f-right d-none d-lg-block">
                                <nav>
                                    @if (!isStaff)
                                    {
                                        <ul id="navigation">
                                            <li><a href="/Home/Index">Trang chủ</a></li>
                                            <li><a href="/Room/Index">Danh sách phòng</a></li>
                                            <li><a href="#">Giới thiệu</a></li>
                                            <li><a href="#">Liên hệ</a></li>
                                        </ul>
                                    }
                                </nav>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-2">
                            <div class="header-btn">
                                @if (ViewBag.Username == null)
                                {
                                    <a href="/Account/LoginRegister" class="btn btn1 d-none d-lg-block">Login</a>
                                }
                                else
                                {
                                    <div class="d-flex" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 20px;">
                                        <span style="font-weight: bold; color: #333; margin: 0 15px;">@ViewBag.Username</span>
                                        <a href="/Account/Logout" class="d-none d-lg-block" style="padding: 10px 20px; background-color: #d4a037; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; border: none;">Logout</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="room-area py-4">
            <div class="container">
                <div class="mb-4">
                    @if (isStaff)
                    {
                        <a class="room-detail-back" asp-action="RoomList" asp-controller="Staff">&laquo; Quay lại</a>
                    }
                    else
                    {
                        <a class="room-detail-back" href="/Room/Index">&laquo; Quay lại</a>
                    }
                </div>

                <div class="row g-4 align-items-stretch">
                    <!-- Cột trái: ảnh lớn + thumbnail -->
                    <div class="col-lg-8">
                        <img id="room-main-img"
                        class="room-detail-main-img"
                        src="@imgs[0]"
                        alt="Phòng @Model.RoomNumber" />

                        @if (imgs.Count > 1)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @{ var ti = 0; }
                                @foreach (var u in imgs)
                                {
                                    <a href="javascript:void(0)"
                                    class="room-detail-thumb room-thumb-link @(ti == 0 ? "active" : "")"
                                    data-url="@u"
                                    data-index="@ti">
                                        <img src="@u" alt="" />
                                    </a>
                                    ti++;
                                }
                            </div>
                            <script>
                                document.querySelectorAll('.room-thumb-link').forEach(function (el) {
                                el.addEventListener('click', function () {
                                var url = this.getAttribute('data-url');
                                var main = document.getElementById('room-main-img');
                                if (main) main.src = url;
                                document.querySelectorAll('.room-thumb-link').forEach(function (x) { x.classList.remove('active'); });
                                this.classList.add('active');
                                });
                                });
                            </script>
                        }
                    </div>

                    <!-- Cột phải: thông tin + nút -->
                    <div class="col-lg-4">
                        <div class="room-detail-panel">
                            <h1 class="room-detail-title">Phòng @Model.RoomNumber</h1>

                            <p class="room-detail-line mb-2">
                                <strong>Loại phòng:</strong> @(Model.RoomTypeName ?? "—")
                            </p>
                            <p class="room-detail-line mb-2">
                                <strong>Sức chứa:</strong> @(Model.Capacity.HasValue ? Model.Capacity.Value.ToString() + " người" : "—")
                            </p>
                            <p class="room-detail-line mb-2">
                                <strong>Giá:</strong>
                                <span class="room-detail-price">@(Model.Price.HasValue ? Model.Price.Value.ToString("N0") : "—") VND</span>
                            </p>
                            <p class="room-detail-line mb-0">
                                <strong>Trạng thái:</strong> @DisplayStatus(Model.Status)
                            </p>

                            <div class="room-detail-actions">
                                @if (!isStaff)
                                {
                                    <a class="room-btn" href="/Booking/Create?roomId=@Model.RoomId">Đặt Ngay </a>
                                    <a class="room-detail-btn-gold" href="/Home/Index">Trang chủ</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mô tả full width -->
                <div class="room-desc-box">
                    <h4>Mô tả</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có mô tả cho loại phòng này. Bạn có thể cập nhật cột <code>Description</code> trong bảng <code>RoomTypes</code> trên SQL Server.</p>
                    }
                </div>

                <div class="feedback-box" id="feedback-section">
                    <h4 class="mb-3">Đánh giá từ khách hàng</h4>

                    @if (TempData["FeedbackSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["FeedbackSuccess"]</div>
                    }

                    @if (TempData["FeedbackError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["FeedbackError"]</div>
                    }

                    <div class="feedback-summary">
                        <div>
                            <div class="feedback-score">@Model.AverageRating.ToString("0.0")/5</div>
                            <div class="feedback-stars">@RenderStars((int)Math.Round(Model.AverageRating, MidpointRounding.AwayFromZero))</div>
                        </div>
                        <div class="text-muted">
                            @(Model.Feedbacks.Count) đánh giá cho phòng @Model.RoomNumber
                        </div>
                    </div>

                    @if (Model.Feedbacks.Count == 0)
                    {
                        <p class="text-muted mb-0">Phòng này chưa có feedback nào.</p>
                    }
                    else
                    {
                        @foreach (var feedback in Model.Feedbacks)
                        {
                            <div class="feedback-item">
                                <div class="d-flex justify-content-between flex-wrap gap-2">
                                    <div>
                                        <div class="feedback-name">@(feedback.FullName ?? "Khách hàng")</div>
                                        <div class="feedback-stars">@RenderStars(feedback.Rating)</div>
                                    </div>
                                    <div class="feedback-date">
                                        @(feedback.FeedbackDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(feedback.Comment))
                                {
                                    <div class="feedback-comment">@feedback.Comment</div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="feedback-form">
                    <h4 class="mb-3">Viết đánh giá</h4>

                    @if (canSubmitFeedback)
                    {
                        <form method="post" asp-action="AddFeedback" asp-controller="Room">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.RoomId" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số sao</label>
                                <select name="rating" class="form-select" required>
                                    <option value="">Chọn số sao</option>
                                    <option value="5">5 sao - Rất tốt</option>
                                    <option value="4">4 sao - Tốt</option>
                                    <option value="3">3 sao - Ổn</option>
                                    <option value="2">2 sao - Chưa tốt</option>
                                    <option value="1">1 sao - Tệ</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nhận xét</label>
                                <textarea name="comment"
                                          class="form-control"
                                          placeholder="Chia sẻ trải nghiệm của bạn về phòng này"></textarea>
                            </div>

                            <button type="submit" class="room-detail-btn-gold">Gửi đánh giá</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            @if (string.IsNullOrWhiteSpace(username))
                            {
                                <span>Bạn cần <a href="/Account/LoginRegister">đăng nhập</a> bằng tài khoản khách hàng để gửi feedback.</span>
                            }
                            else
                            {
                                @(feedbackEligibilityMessage ?? "Bạn hiện chưa thể gửi feedback cho phòng này.")
                            }
                        </p>
                    }
                </div>
            </div>
        </section>
    </main>

    <script src="~/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>
