@model HotelManagement.Models.Common.PagedResult<HotelManagement.Models.ViewModels.RoomViewModel>
@{
    ViewData["Title"] = "Danh sách phòng";
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Danh sách phòng - Hotel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.ico">

    <!-- CSS -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">

    <style>
        :root {
            --room-gold: #d4a037;
            --room-gold-hover: #b8922f;
            --room-price: #198754;
            --room-text-muted: #6c757d;
        }

        .room-card {
            display: flex;
            gap: 20px;
            background: #fff;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
            margin-bottom: 20px;
            align-items: center;
        }

            .room-card img {
                width: 320px;
                height: 200px;
                object-fit: cover;
                border-radius: 10px;
            }

        .room-info {
            flex: 1;
        }

        .room-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .room-text {
            color: var(--room-text-muted);
            margin-bottom: 6px;
        }

        .room-price {
            color: var(--room-price);
            font-weight: 700;
            font-size: 18px;
        }

        .room-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 180px;
        }

        .room-filter {
            background: #fff;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
            margin-bottom: 24px;
        }

        .room-btn {
            background: var(--room-gold);
            color: #fff !important;
            border: none;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            text-decoration: none;
        }

            .room-btn:hover {
                background: var(--room-gold-hover);
                color: #fff !important;
            }
    </style>
</head>

<body>
    <header>
        <div class="header-area header-sticky">
            <div class="main-header">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-2 col-lg-2">
                            <div class="logo">
                                <a href="/Home/Index"><img src="/assets/img/logo/logo.png" alt=""></a>
                            </div>
                        </div>

                        <div class="col-xl-8 col-lg-8">
                            <div class="main-menu f-right d-none d-lg-block">
                                <nav>
                                    <ul id="navigation">
                                        <li><a href="/Home/Index">Trang chủ</a></li>
                                        <li class="active"><a href="/Room/Index">Danh sách phòng</a></li>
                                        <li><a href="#">Giới thiệu</a></li>
                                        <li><a href="#">Liên hệ</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2">
                            <div class="header-btn">
                                @if (ViewBag.Username == null)
                                {
                                    <a href="/Account/LoginRegister" class="btn btn1 d-none d-lg-block">Login</a>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2">
                                        <span class="fw-bold text-dark">@ViewBag.Username</span>
                                        <a href="/Account/Logout" class="btn btn-sm" style="background:#d4a037;color:white;">Logout</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="room-area">
            <div class="container py-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold">Danh sách phòng</h2>
                    <a class="btn btn1" href="/Home/Index">Quay lại</a>
                </div>

                <form method="get" asp-action="Index" asp-controller="Room" class="room-filter">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-6">
                            <label class="form-label fw-semibold">Tìm kiếm</label>
                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Nhập số phòng, loại phòng hoặc trạng thái" />
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select name="status" class="form-select">
                                <option value="">Tất cả trạng thái</option>
                                @if ((string?)ViewBag.Status == "Available")
                                {
                                    <option value="Available" selected>Available</option>
                                }
                                else
                                {
                                    <option value="Available">Available</option>
                                }
                                @if ((string?)ViewBag.Status == "Booked")
                                {
                                    <option value="Booked" selected>Booked</option>
                                }
                                else
                                {
                                    <option value="Booked">Booked</option>
                                }
                                @if ((string?)ViewBag.Status == "Occupied")
                                {
                                    <option value="Occupied" selected>Occupied</option>
                                }
                                else
                                {
                                    <option value="Occupied">Occupied</option>
                                }
                                @if ((string?)ViewBag.Status == "Maintenance")
                                {
                                    <option value="Maintenance" selected>Maintenance</option>
                                }
                                else
                                {
                                    <option value="Maintenance">Maintenance</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100">Lọc</button>
                            <a href="@Url.Action("Index", "Room")" class="btn btn-outline-secondary w-100">Xóa lọc</a>
                        </div>
                    </div>
                </form>

                @foreach (var room in Model.Items)
                {
                    var img = (room.ImageUrls != null && room.ImageUrls.Count > 0)
                    ? room.ImageUrls[0]
                    : "/assets/img/rooms/room1.jpg";

                    <div class="room-card">
                        <!-- Ảnh -->
                        <img src="@img" alt="Room @room.RoomNumber" />

                        <!-- Thông tin -->
                        <div class="room-info">
                            <div class="room-title">Phòng @room.RoomNumber</div>

                            <div class="room-text">
                                Loại: @(room.RoomTypeName ?? "—")
                            </div>

                            <div class="room-price">
                                @(room.Price?.ToString("N0")) VND
                            </div>

                            <div class="room-text">
                                Trạng thái: @(room.Status ?? "—")
                            </div>
                        </div>

                        <!-- Button -->
                        <div class="room-actions">
                            <a class="room-btn"
                               href="@Url.Action("Detail", "Room", new { id = room.RoomId })">
                                Xem Ngay
                            </a>

                            <a class="room-btn" href="/Booking/Create?roomId=@room.RoomId">
                                Đặt Ngay
                            </a>
                        </div>
                    </div>
                }

                @if (Model == null || Model.Items.Count == 0)
                {
                    <div class="alert alert-warning mt-4">Chưa có dữ liệu phòng.</div>
                }

            </div>
            <div class="text-center mt-4">
                @for (int i = 1; i <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
                {
                    <a href="@Url.Action("Index", new { page = i, search = ViewBag.Search, status = ViewBag.Status })"
                       class="btn @(i == Model.Page ? "btn-primary" : "btn-outline-primary") mx-1">
                        @i
                    </a>
                }
            </div>
        </section>
    </main>

    <script src="~/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>
