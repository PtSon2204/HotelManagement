@model List<HotelManagement.Models.ViewModels.RoomViewModel>

@{
    ViewData["Title"] = "Danh sách phòng";
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Rooms - Hotel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon.ico">

    <!-- CSS (reuse style bundle used by Home) -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
</head>

<body>
    <header>
        <div class="header-area header-sticky">
            <div class="main-header">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-2 col-lg-2">
                            <div class="logo">
                                <a href="/Home/Index"><img src="/assets/img/logo/logo.png" alt=""></a>
                            </div>
                        </div>

                        <div class="col-xl-8 col-lg-8">
                            <div class="main-menu f-right d-none d-lg-block">
                                <nav>
                                    <ul id="navigation">
                                        <li><a href="/Home/Index">Trang chủ</a></li>
                                        <li class="active"><a href="/Room/Index">Danh sách phòng</a></li>
                                        <li><a href="#">Giới thiệu</a></li>
                                        <li><a href="#">Dịch vụ</a></li>
                                        <li><a href="#">Liên hệ</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2">
                            <div class="header-btn">
                                @if (ViewBag.Username == null)
                                {
                                    <a href="/Account/LoginRegister" class="btn btn1 d-none d-lg-block">Login</a>
                                }
                                else
                                {
                                    <div class="d-flex" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 20px;">
                                        <span style="font-weight: bold; color: #333; margin: 0 15px;">@ViewBag.Username</span>
                                        <a href="/Account/Logout" class="d-none d-lg-block" style="padding: 10px 20px; background-color: #d4a037; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; border: none;">
                                            Logout
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="room-area">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="text-dark fw-bold">Danh sách phòng</h2>
                    <a class="btn btn1" href="/Home/Index">Quay lại</a>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var room in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm" style="border: 0; border-radius: 12px; overflow: hidden;">
                                <img
                                    src="@(string.IsNullOrWhiteSpace(room.Image) ? "/assets/img/rooms/room1.jpg" : room.Image)"
                                    class="card-img-top"
                                    style="height: 200px; object-fit: cover;"
                                    alt="Room @room.RoomNumber" />

                                <div class="card-body">
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="flex-grow-1">
                                            <h5 class="card-title fw-bold">Phòng @room.RoomNumber</h5>
                                            <p class="card-text mb-2">
                                                <small class="text-muted">Loại: @(room.RoomTypeName ?? "")</small>
                                            </p>
                                            <p class="card-text mb-2">
                                                <strong class="text-success">@room.Price</strong>
                                            </p>
                                            <p class="card-text mb-0">
                                                <small class="text-muted">Trạng thái: @(room.Status ?? "")</small>
                                            </p>
                                        </div>

                                        <div class="d-flex flex-column gap-4" style="min-width: 200px;">
                                            <a class="btn btn1 btn-sm w-100" href="@Url.Action("Detail", "Room", new { id = room.RoomId })">Xem ngay</a>
                                            <a class="btn btn-outline-secondary btn-sm w-100" href="#">Đặt ngay</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model == null || Model.Count == 0)
                {
                    <div class="alert alert-warning mt-4">Chưa có dữ liệu phòng.</div>
                }
            </div>
        </section>
    </main>

    <script src="~/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/main.js"></script>
</body>
</html>

