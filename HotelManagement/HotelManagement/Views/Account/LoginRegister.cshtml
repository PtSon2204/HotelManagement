@model Tuple<HotelManagement.Models.ViewModels.LoginViewModel, HotelManagement.Models.ViewModels.RegisterViewModel>

@{
    ViewData["Title"] = "Marian | Đăng nhập & Đăng ký";
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    
    <!-- CSS here (Replicated from Home/Index) -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/gijgo.css">
    <link rel="stylesheet" href="~/assets/css/slicknav.css">
    <link rel="stylesheet" href="~/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="~/assets/css/themify-icons.css">
    <link rel="stylesheet" href="~/assets/css/slick.css">
    <link rel="stylesheet" href="~/assets/css/nice-select.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
    <link rel="stylesheet" href="~/assets/css/login-register-premium.css">
    <style>
        .google-login-btn {
            width: 100%;
            border: none;
            background: #2f67c7;
            color: #fff;
            border-radius: 0;
            min-height: 52px;
            display: flex;
            align-items: center;
            padding: 0;
            overflow: hidden;
            font-size: 18px;
            font-weight: 700;
            transition: opacity .2s ease;
        }

        .google-login-btn:hover {
            opacity: .92;
            color: #fff;
        }

        .google-login-icon-wrap {
            width: 82px;
            min-width: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .google-login-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #1f1f1f;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

        .google-login-text {
            flex: 1;
            text-align: left;
        }

        .password-field {
            position: relative;
        }

        .password-field .form-control-premium {
            padding-right: 88px;
        }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #8a8a8a;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            padding: 4px 6px;
        }
    </style>
</head>
<body class="premium-login-page">

    <div class="back-to-home">
        <a href="/Home/Index"><i class="fas fa-arrow-left me-2"></i>Trang chủ</a>
    </div>

    <main class="d-flex align-items-center justify-content-center" style="min-height: 100vh; position: relative; z-index: 2;">
        <div class="auth-container">
            <div class="auth-card">
                <h2><span>Marian</span></h2>
                
                <div id="auth-main-content">
                    <div class="auth-tabs">
                        <button id="tab-login" class="auth-tab active" onclick="switchTab('login')">Đăng nhập</button>
                        <button id="tab-register" class="auth-tab" onclick="switchTab('register')">Đăng ký</button>
                    </div>

                    <div class="auth-content-wrapper">
                        <div id="form-slider" class="auth-form-slider show-login">
                            <!-- Login Section -->
                            <div class="auth-form-column">
                                <div id="section-login" class="auth-section active">
                                    <form asp-action="Login" asp-controller="Account" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <div class="form-group">
                                            <label for="login-username">Gmail</label>
                                            <input id="login-username"
                                                   name="Username"
                                                   class="form-control-premium"
                                                   value="@Model.Item1.Username"
                                                   placeholder="Nhập Gmail của bạn"
                                                   required />
                                        </div>
                                        <div class="form-group">
                                            <label for="login-password">Mật khẩu</label>
                                            <div class="password-field">
                                                <input id="login-password"
                                                       name="Password"
                                                       class="form-control-premium"
                                                       type="password"
                                                       placeholder="Nhập mật khẩu"
                                                       required />
                                                <button type="button" class="toggle-password-btn" data-target="login-password">Hiện</button>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn-premium">Đăng nhập</button>
                                    </form>
                                    <form asp-action="LoginWithGoogle" asp-controller="Account" method="post" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="google-login-btn">
                                            <span class="google-login-icon-wrap">
                                                <span class="google-login-icon">G</span>
                                            </span>
                                            <span class="google-login-text">Đăng nhập bằng Google</span>
                                        </button>
                                    </form>
                                    <div class="auth-footer">
                                        <a href="javascript:void(0)" onclick="showForgotPassword()">Quên mật khẩu?</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Register Section -->
                            <div class="auth-form-column">
                                <div id="section-register" class="auth-section">
                                    <form asp-action="Register" asp-controller="Account" method="post" class="mt-2">
                                        <div class="form-group">
                                            <label for="register-username">Tên đăng nhập</label>
                                            <input id="register-username" name="Username" class="form-control-premium" value="@Model.Item2.Username" required />
                                        </div>
                                        <div class="form-group">
                                            <label for="register-email">Email</label>
                                            <input id="register-email" name="Email" class="form-control-premium" type="email" value="@Model.Item2.Email" required />
                                        </div>
                                        <div class="form-group">
                                            <label for="register-password">Mật khẩu</label>
                                            <div class="password-field">
                                                <input id="register-password" name="Password" class="form-control-premium" type="password" required />
                                                <button type="button" class="toggle-password-btn" data-target="register-password">Hiện</button>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="register-confirmPassword">Xác nhận mật khẩu</label>
                                            <div class="password-field">
                                                <input id="register-confirmPassword" name="ConfirmPassword" class="form-control-premium" type="password" required />
                                                <button type="button" class="toggle-password-btn" data-target="register-confirmPassword">Hiện</button>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn-premium">Đăng ký ngay</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Forgot Password Section (Initially Hidden) -->
                <div id="section-forgot" class="auth-section" style="display: none;">
                    <h3 class="text-center mb-4" style="font-family: 'Playfair Display', serif; color: var(--premium-gold);">Quên mật khẩu</h3>
                    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                        <div class="form-group">
                            <label for="forgot-email">Gmail đã đăng ký</label>
                            <input id="forgot-email"
                                   name="Email"
                                   class="form-control-premium"
                                   type="email"
                                   placeholder="Nhập Gmail đã đăng ký"
                                   required />
                        </div>
                        <button type="submit" class="btn-premium">Gửi mật khẩu mới</button>
                    </form>
                    <div class="auth-footer">
                        <a href="javascript:void(0)" onclick="hideForgotPassword()">Quay lại Đăng nhập</a>
                    </div>
                </div>

                <!-- Validation Messages -->
                <div class="mt-4 text-center">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger small">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div><i class="fas fa-exclamation-circle me-1"></i> @error.ErrorMessage</div>
                            }
                        </div>
                    }

                    @if (TempData["ForgotPasswordSuccess"] != null)
                    {
                        <div class="text-success small">
                            <i class="fas fa-check-circle me-1"></i> @TempData["ForgotPasswordSuccess"]
                        </div>
                    }

                    @if (TempData["OtpSuccess"] != null)
                    {
                        <div class="text-success small">
                            <i class="fas fa-check-circle me-1"></i> @TempData["OtpSuccess"]
                        </div>
                    }

                    @if (TempData["RegisterSuccess"] != null)
                    {
                        <div class="text-success small">
                            <i class="fas fa-check-circle me-1"></i> @TempData["RegisterSuccess"]
                        </div>
                    }

                    @if (TempData["GoogleLoginError"] != null)
                    {
                        <div class="text-danger small">
                            <i class="fas fa-exclamation-circle me-1"></i> @TempData["GoogleLoginError"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <!-- JS here (Replicated from Home/Index) -->
    <script src="~/assets/js/vendor/modernizr-3.5.0.min.js"></script>
    <script src="~/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/jquery.slicknav.min.js"></script>
    <script src="~/assets/js/owl.carousel.min.js"></script>
    <script src="~/assets/js/slick.min.js"></script>
    <script src="~/assets/js/gijgo.min.js"></script>
    <script src="~/assets/js/wow.min.js"></script>
    <script src="~/assets/js/animated.headline.js"></script>
    <script src="~/assets/js/jquery.magnific-popup.js"></script>
    <script src="~/assets/js/jquery.scrollUp.min.js"></script>
    <script src="~/assets/js/jquery.nice-select.min.js"></script>
    <script src="~/assets/js/jquery.sticky.js"></script>
    <script src="~/assets/js/plugins.js"></script>
    <script src="~/assets/js/main.js"></script>

    <script>
        function switchTab(tab) {
            $('.auth-tab').removeClass('active');
            $('.auth-section').removeClass('active');
            
            $('#tab-' + tab).addClass('active');
            $('#section-' + tab).addClass('active');
            
            if (tab === 'login') {
                $('#form-slider').removeClass('show-register').addClass('show-login');
            } else {
                $('#form-slider').removeClass('show-login').addClass('show-register');
            }
            
            $('#auth-main-content').show();
            $('#section-forgot').hide();
        }

        function showForgotPassword() {
            $('.auth-section').removeClass('active');
            $('#auth-main-content').fadeOut(300, function() {
                $('#section-forgot').show().addClass('active');
            });
        }

        function hideForgotPassword() {
            $('#section-forgot').removeClass('active').fadeOut(300, function() {
                $('#auth-main-content').fadeIn(300);
                switchTab('login');
            });
        }

        $(document).ready(function() {
            var hash = window.location.hash;
            if (hash === '#register') {
                switchTab('register');
            }

            document.querySelectorAll('.toggle-password-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    var targetId = this.getAttribute('data-target');
                    var input = document.getElementById(targetId);
                    if (!input) return;

                    var isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    this.textContent = isPassword ? 'Ẩn' : 'Hiện';
                });
            });
        });
    </script>
</body>
</html>

