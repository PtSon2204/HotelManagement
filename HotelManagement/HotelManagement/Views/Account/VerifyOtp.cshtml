@model HotelManagement.Models.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác thực OTP";
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f9f5ec 0%, #fff 100%);
        }

        .otp-card {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: 18px;
            padding: 32px 28px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, .08);
        }

        .otp-title {
            font-size: 28px;
            font-weight: 700;
            color: #1f2937;
        }

        .otp-subtitle {
            color: #6b7280;
            margin-bottom: 24px;
        }

        .otp-btn {
            background: #d4a037;
            border: none;
            width: 100%;
            padding: 12px 16px;
            color: #fff;
            border-radius: 10px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="otp-card">
        <div class="otp-title mb-2">Xác thực tài khoản</div>
        <div class="otp-subtitle">Nhập mã OTP 6 số đã được gửi tới email của bạn để kích hoạt tài khoản.</div>

        <form asp-action="VerifyOtp" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Username" type="hidden" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Tên đăng nhập</label>
                <input value="@Model.Username" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="OtpCode" class="form-label fw-semibold">Mã OTP</label>
                <input asp-for="OtpCode" class="form-control" maxlength="6" placeholder="Nhập 6 số OTP" />
                <span asp-validation-for="OtpCode" class="text-danger"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <button type="submit" class="otp-btn">Kích hoạt tài khoản</button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="LoginRegister" asp-controller="Account">Quay lại đăng nhập</a>
        </div>
    </div>
</body>
</html>
