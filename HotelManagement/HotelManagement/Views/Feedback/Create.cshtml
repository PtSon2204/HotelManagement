@{
    ViewData["Title"] = "Gửi Đánh Giá";
}

<div class="row justify-content-center mt-5 mb-5 pb-5">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white p-4">
                <h3 class="mb-0"><i class="fas fa-star text-warning"></i> Gửi Đánh Giá Trải Nghiệm</h3>
                <p class="mb-0">Ý kiến của bạn giúp chúng tôi cải thiện chất lượng dịch vụ.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="form-group mb-4">
                        <label class="font-weight-bold">Mức độ hài lòng: <span class="text-danger">*</span></label>
                        <div class="rating-stars d-flex justify-content-center star-rating" style="font-size: 2rem;">
                            <!-- Mặc định chọn 5 sao -->
                            <div class="form-check form-check-inline mx-2">
                                <input class="form-check-input d-none" type="radio" name="rating" id="r1" value="1">
                                <label class="form-check-label" for="r1"><i class="far fa-star text-warning star-icon"></i><div class="small text-center text-muted">1</div></label>
                            </div>
                            <div class="form-check form-check-inline mx-2">
                                <input class="form-check-input d-none" type="radio" name="rating" id="r2" value="2">
                                <label class="form-check-label" for="r2"><i class="far fa-star text-warning star-icon"></i><div class="small text-center text-muted">2</div></label>
                            </div>
                            <div class="form-check form-check-inline mx-2">
                                <input class="form-check-input d-none" type="radio" name="rating" id="r3" value="3">
                                <label class="form-check-label" for="r3"><i class="far fa-star text-warning star-icon"></i><div class="small text-center text-muted">3</div></label>
                            </div>
                            <div class="form-check form-check-inline mx-2">
                                <input class="form-check-input d-none" type="radio" name="rating" id="r4" value="4">
                                <label class="form-check-label" for="r4"><i class="far fa-star text-warning star-icon"></i><div class="small text-center text-muted">4</div></label>
                            </div>
                            <div class="form-check form-check-inline mx-2">
                                <input class="form-check-input d-none" type="radio" name="rating" id="r5" value="5" checked>
                                <label class="form-check-label" for="r5"><i class="fas fa-star text-warning star-icon"></i><div class="small text-center text-muted">5</div></label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="comment" class="font-weight-bold">Nhận xét chi tiết (Tuỳ chọn):</label>
                        <textarea class="form-control" name="comment" id="comment" rows="4" placeholder="Ví dụ: Phòng rất sạch sẽ, view đẹp, nhân viên thì thân thiện..."></textarea>
                    </div>

                    <div class="form-group text-right border-top pt-3">
                        <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-secondary mr-2"><i class="fas fa-times"></i> Hủy</a>
                        <button type="submit" class="btn btn-primary" style="background-color: #d4a037; border-color: #d4a037;"><i class="fas fa-paper-plane"></i> Chấp nhận Gửi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const labels = document.querySelectorAll('.star-icon');
        const radios = document.querySelectorAll('input[name="rating"]');

        function updateStars(selectedValue) {
            labels.forEach((label, index) => {
                if (index < selectedValue) {
                    label.classList.remove('far');
                    label.classList.add('fas');
                } else {
                    label.classList.remove('fas');
                    label.classList.add('far');
                }
            });
        }

        radios.forEach((radio, idx) => {
            radio.addEventListener('change', function () {
                updateStars(this.value);
            });
            // Hover effect (optional)
            radio.parentElement.addEventListener('mouseover', function () {
                updateStars(radio.value);
            });
            radio.parentElement.addEventListener('mouseout', function () {
                var checkedVal = document.querySelector('input[name="rating"]:checked').value;
                updateStars(checkedVal);
            });
        });
    });
</script>
